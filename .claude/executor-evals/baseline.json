      "buildStatus": { "type": "string", "enum": ["passed", "failed", "skipped"], "description": "Targeted project build status" },
      "finalStatus": { "type": "string", "enum": ["READY", "READY_WITH_KNOWN_ISSUES", "BLOCKED"], "description": "Final release gate verdict" },
      "metrics": {
        "type": "object",
        "description": "Categorized metric breakdowns per Roadmap Section 10.5",
