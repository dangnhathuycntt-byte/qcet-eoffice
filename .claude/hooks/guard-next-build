#!/usr/bin/env bash
set -euo pipefail

# -----------------------------------------------------------------------------
# QCET Deterministic Hook: guard-next-build
# Prevents 'next build' cache corruption while dev server is running on port 3001
# Enforces QCET CLAUDE.md Rule 1 (Dev & Build Cache Conflict)
# -----------------------------------------------------------------------------

STDIN_DATA=""
if [ ! -t 0 ]; then
  STDIN_DATA=$(cat || true)
fi

COMMAND=""
if [ $# -gt 0 ]; then
  COMMAND="$*"
elif [ -n "$STDIN_DATA" ]; then
  if echo "$STDIN_DATA" | jq -e . >/dev/null 2>&1; then
    COMMAND=$(echo "$STDIN_DATA" | jq -r '.tool_input.command // empty' 2>/dev/null || true)
  else
    COMMAND="$STDIN_DATA"
  fi
fi

# Check if command is a Next.js production build command
is_build_command() {
  local cmd="$1"
  if echo "$cmd" | grep -E '(^|[[:space:];&|])(next[[:space:]]+build|npm[[:space:]]+run[[:space:]]+build|pnpm[[:space:]]+(run[[:space:]]+)?build|yarn[[:space:]]+build|bun[[:space:]]+run[[:space:]]+build)([[:space:];&|]|$)' >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

# If not a build command, allow immediately
if ! is_build_command "$COMMAND"; then
  exit 0
fi

# Check if dev server is active on port 3001
PORT_3001_ACTIVE=0

if lsof -ti:3001 >/dev/null 2>&1; then
  PORT_3001_ACTIVE=1
elif nc -z 127.0.0.1 3001 >/dev/null 2>&1; then
  PORT_3001_ACTIVE=1
fi

if [ "$PORT_3001_ACTIVE" -eq 1 ]; then
  REASON="Dev server active on port 3001. Running 'next build' overwrites .next/ with production chunks and corrupts the dev server, causing 404 asset failures and unstyled HTML on localhost:3001 (QCET Rule 1)."

  >&2 cat <<EOF
================================================================================
[QCET Build Guard] EXECUTION BLOCKED: Dev server running on port 3001!
================================================================================
$REASON

HOW TO VERIFY CODE SAFELY:
  1. Use static verification (zero cache risk):
     npm run typecheck
     npm test

HOW TO RECOVER OR STOP DEV SERVER:
  2. If production build is strictly necessary, stop the dev server first:
     kill -9 \$(lsof -ti:3001)
     npm run build
================================================================================
EOF

  cat <<EOF
{
  "decision": "block",
  "reason": "$REASON",
  "hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "permissionDecision": "deny",
    "permissionDecisionReason": "$REASON"
  }
}
EOF
  exit 2
fi

exit 0
