#!/usr/bin/env node

/**
 * QCET PreToolUse Ownership Guard
 *
 * Enforces architectural lifecycle invariants:
 * 1. Intercepts Write and Edit tool invocations.
 * 2. Prohibits read-only agents (recon, skeptic, researcher, verifiers, reviewers) from modifying files.
 * 3. Resolves active shard ownership (owns, antiOwns) from state files or environment variables.
 * 4. Blocks out-of-scope modifications and antiOwns violations with actionable remediation reasons.
 * 5. Fail-safes to exit 0 outside executor workflows (interactive sessions, unmapped agents, non-Write tools).
 */

const fs = require('fs');
const path = require('path');

// -----------------------------------------------------------------------------
// PROTOCOL CONSTANTS & EXIT CODES
// -----------------------------------------------------------------------------
const EXIT_ALLOW = 0;
const EXIT_BLOCK = 2;

// Known read-only agent types or roles
const READ_ONLY_AGENTS = new Set([
  'qcet-recon',
  'qcet-skeptic',
  'qcet-researcher',
  'verifier',
  'verify',
  'data-reviewer',
  'security-reviewer',
  'ux-reviewer',
  'recon',
  'skeptic',
  'researcher',
  'reviewer',
  'auditor'
]);

// -----------------------------------------------------------------------------
// DETERMINISTIC PATH & GLOB UTILITIES
// -----------------------------------------------------------------------------
const {
  normalizePath,
  globToRegex,
  matchesOwnership,
  toRepoRelativePath,
} = require('./path-matcher.cjs');

const {
  getRunDir,
  readJson,
  claimFile,
} = require('./qcet-run-state.cjs');
const { spawnSync } = require('child_process');

// -----------------------------------------------------------------------------
// READ-ONLY AGENT DETECTION
// -----------------------------------------------------------------------------
function isReadOnlyAgent(agentType, agentId, agentRole, subagentLabel) {
  const candidates = [agentType, agentId, agentRole, subagentLabel]
    .filter(Boolean)
    .map((s) => String(s).toLowerCase().trim());

  for (const c of candidates) {
    if (READ_ONLY_AGENTS.has(c)) {
      return true;
    }
    // Pattern match for specialized read-only roles
    if (
      /(?:^|[-_:])(recon|skeptic|researcher|verifier|verify|reviewer|review|audit)(?:[-_:]|$)/i.test(c) ||
      /\b(recon|skeptic|researcher|verifier|verify|reviewer|review|audit)\b/i.test(c)
    ) {
      // Exempt utility and synchronizer agents from read-only categorization
      if (c.includes('recorder') || c.includes('synchronizer') || c.includes('telemetry')) {
        continue;
      }
      return true;
    }
  }
  return false;
}

// -----------------------------------------------------------------------------
// SHARD MAPPING RESOLUTION
// -----------------------------------------------------------------------------
function extractCandidateShardIds(agentId, subagentLabel) {
  const candidates = new Set();
  for (const raw of [agentId, subagentLabel].filter(Boolean)) {
    const s = String(raw).trim();
    candidates.add(s);

    // Strip leading prefix like builder:, repair:, implement:, etc.
    const withoutPrefix = s.replace(/^(builder|repair|implement|reconcile|attempt)[:\-_]/i, '');
    candidates.add(withoutPrefix);

    // Strip trailing suffix like :repair, :repair-1, :attempt-1, :1
    const withoutSuffix = withoutPrefix.replace(/[:\-_](repair(-\d+)?|implement|attempt(-\d+)?|\d+)$/i, '');
    candidates.add(withoutSuffix);

    // Match colon/hyphen separated segments
    if (s.includes(':')) {
      const parts = s.split(':');
      for (const p of parts) {
        if (p && !['builder', 'repair', 'attempt', 'implement', 'reconcile'].includes(p.toLowerCase())) {
          candidates.add(p);
        }
      }
    }
  }
  return [...candidates].filter(Boolean);
}

function resolveActiveShard(agentId, agentType, subagentLabel) {
  // 1. Check explicit environment variables
  if (process.env.QCET_CURRENT_SHARD) {
    try {
      const parsed = JSON.parse(process.env.QCET_CURRENT_SHARD);
      if (parsed && typeof parsed === 'object') return parsed;
    } catch (_) {}
  }

  if (process.env.QCET_SHARD_OWNS) {
    let owns = [];
    try {
      owns = JSON.parse(process.env.QCET_SHARD_OWNS);
    } catch (_) {
      owns = process.env.QCET_SHARD_OWNS.split(',').map((s) => s.trim()).filter(Boolean);
    }
    let antiOwns = [];
    if (process.env.QCET_SHARD_ANTI_OWNS) {
      try {
        antiOwns = JSON.parse(process.env.QCET_SHARD_ANTI_OWNS);
      } catch (_) {
        antiOwns = process.env.QCET_SHARD_ANTI_OWNS.split(',').map((s) => s.trim()).filter(Boolean);
      }
    }
    return {
      id: process.env.QCET_SHARD_ID || 'env-configured-shard',
      owns,
      antiOwns
    };
  }

  let stateData = null;

  // Check QCET_ACTIVE_SHARDS env var (can be JSON string or file path)
  if (process.env.QCET_ACTIVE_SHARDS) {
    const val = process.env.QCET_ACTIVE_SHARDS.trim();
    try {
      if (val.startsWith('{') || val.startsWith('[')) {
        stateData = JSON.parse(val);
      } else if (fs.existsSync(val)) {
        stateData = JSON.parse(fs.readFileSync(val, 'utf8'));
      }
    } catch (_) {}
  }

  // 2. Candidate state file locations (prioritize run-scoped files)
  if (!stateData) {
    const runId = process.env.QCET_RUN_ID || '';
    const sessionScope = process.env.QCET_SESSION_ID || process.env.CLAUDE_CONVERSATION_ID || '';
    const candidateFiles = [
      process.env.QCET_ACTIVE_SHARDS_FILE,
      process.env.QCET_STATE_FILE,
      runId ? path.join('/tmp', `qcet-active-shards-${runId}.json`) : null,
      sessionScope ? path.join('/tmp', `qcet-active-shards-${sessionScope}.json`) : null,
      path.join('/tmp', 'qcet-active-shards.json'),
      path.join('/tmp', 'qcet-shard-ownership.json'),
      path.join(process.cwd(), '.claude', 'state', 'active-shards.json'),
      path.join(process.cwd(), '.claude', 'state', 'qcet-active-shards.json')
    ].filter(Boolean);

    for (const file of candidateFiles) {
      try {
        if (fs.existsSync(file)) {
          const raw = fs.readFileSync(file, 'utf8');
          stateData = JSON.parse(raw);
          if (stateData) break;
        }
      } catch (_) {}
    }
  }

  if (!stateData) return null;

  const candidateIds = extractCandidateShardIds(agentId, subagentLabel);

  // Helper to match shard against candidate IDs
  function matchesShard(shard) {
    if (!shard || typeof shard !== 'object') return false;
    const shardId = shard.id || shard.agentId || shard.agent_id;
    if (!shardId) return false;
    if (candidateIds.includes(shardId)) return true;
    for (const c of candidateIds) {
      if (shardId === c || shardId.startsWith(c + ':') || c.startsWith(shardId + ':')) return true;
    }
    return false;
  }

  // Structure A: Array of shards
  if (Array.isArray(stateData)) {
    if (candidateIds.length > 0) {
      const match = stateData.find(matchesShard);
      if (match) return match;
    }
    if ((agentId || subagentLabel) && stateData.length === 1) return stateData[0];
    return null;
  }

  // Structure B: Object keyed by agent_id or shard_id
  if (typeof stateData === 'object') {
    for (const c of candidateIds) {
      if (stateData[c]) return stateData[c];
    }
    // Nested activeShards property
    if (Array.isArray(stateData.activeShards)) {
      if (candidateIds.length > 0) {
        const match = stateData.activeShards.find(matchesShard);
        if (match) return match;
      }
      if ((agentId || subagentLabel) && stateData.activeShards.length === 1) return stateData.activeShards[0];
    }
    // Nested shards array (manifest format)
    if (Array.isArray(stateData.shards)) {
      if (candidateIds.length > 0) {
        const match = stateData.shards.find(matchesShard);
        if (match) return match;
      }
      if ((agentId || subagentLabel) && stateData.shards.length === 1) return stateData.shards[0];
    }
    // Single shard object with 'owns'
    if (Array.isArray(stateData.owns)) {
      if ((agentId || subagentLabel) && (candidateIds.length === 0 || matchesShard(stateData))) {
        return stateData;
      }
    }
  }

  return null;
}

// -----------------------------------------------------------------------------
// WORKTREE IDENTITY & REPO VERIFICATION
// -----------------------------------------------------------------------------
function verifyWorktreeIdentity(runDir, shard, explicitCwd) {
  const shardId = (shard && (shard.id || shard.shardId || shard.agentId)) || process.env.QCET_SHARD_ID || '';
  if (!shardId) {
    block('WORKTREE_INVALID: missing required shard identity during executor run');
  }

  const witnessPath = path.join(runDir, 'shards', shardId, 'worktree.json');
  if (!fs.existsSync(witnessPath)) {
    block(`WORKTREE_INVALID: missing required worktree witness for shard '${shardId}'`);
  }

  const witness = readJson(witnessPath);
  if (!witness || !witness.root) {
    block(`WORKTREE_INVALID: invalid worktree witness for shard '${shardId}'`);
  }

  const effectiveCwd = explicitCwd || process.cwd();
  const gitRootRes = spawnSync('git', ['rev-parse', '--show-toplevel'], {
    cwd: effectiveCwd,
    encoding: 'utf8',
  });
  if (gitRootRes.status !== 0 || !gitRootRes.stdout) {
    block(`WORKTREE_INVALID: unable to resolve git root for '${effectiveCwd}'`);
  }
  const actualGitRoot = gitRootRes.stdout.trim();

  function resolveReal(p) {
    try {
      return fs.realpathSync(path.resolve(p));
    } catch (_) {
      return path.resolve(p);
    }
  }

  if (resolveReal(actualGitRoot) !== resolveReal(witness.root)) {
    block(`WORKTREE_INVALID: cwd root mismatch (expected '${witness.root}', got '${actualGitRoot}')`);
  }

  if (witness.baseCommit || witness.baseRef) {
    const base = witness.baseCommit || witness.baseRef;
    const ancestorRes = spawnSync('git', ['merge-base', '--is-ancestor', base, 'HEAD'], {
      cwd: effectiveCwd,
      encoding: 'utf8',
    });
    if (ancestorRes.status !== 0) {
      block(`WORKTREE_INVALID: base commit ancestry mismatch for shard '${shardId}'`);
    }
  }

  return { shardId, witness };
}

// -----------------------------------------------------------------------------
// BLOCK EMISSION HELPER
// -----------------------------------------------------------------------------
function block(reason) {
  process.stderr.write(`[QCET Ownership Guard] BLOCKED: ${reason}\n`);
  const response = {
    decision: 'block',
    reason,
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: 'deny',
      permissionDecisionReason: reason
    }
  };
  process.stdout.write(JSON.stringify(response, null, 2) + '\n');
  process.exit(EXIT_BLOCK);
}

function allow() {
  const response = {
    decision: 'allow'
  };
  process.stdout.write(JSON.stringify(response, null, 2) + '\n');
  process.exit(EXIT_ALLOW);
}

function isAllowedReadOnlyShellCommand(command) {
  const text = String(command || '').trim();
  if (!text) return false;

  // Block compound or redirection syntax: &&, ||, ;, |, >, <, `, $(
  if (/[;&|<>]|`|\$\(/.test(text)) {
    return false;
  }

  // Block risky git diff flags
  if (/(?:^|\s)(?:--ext-diff|--no-index|--output(?:=|\s|$))/i.test(text)) {
    return false;
  }

  const allowedPatterns = [
    /^git\s+status(?:\s+.*)?$/,
    /^git\s+diff(?:\s+.*)?$/,
    /^git\s+log(?:\s+.*)?$/,
    /^git\s+show(?:\s+.*)?$/,
    /^git\s+grep(?:\s+.*)?$/,
    /^git\s+rev-parse(?:\s+.*)?$/,
    /^git\s+ls-files(?:\s+.*)?$/,
    /^npm\s+run\s+typecheck(?:\s+.*)?$/,
    /^npm\s+run\s+lint(?:\s+.*)?$/,
    /^npm\s+test(?:\s+.*)?$/,
    /^npm\s+run\s+test(?:\s+.*)?$/,
    /^npx\s+tsx\s+--test(?:\s+.*)?$/,
  ];

  return allowedPatterns.some((pattern) => pattern.test(text));
}

function isMutatingShellCommand(command) {
  const text = String(command || '').trim();
  if (!text) return false;
  const mutatingPrimitive = /(?:^|[;&|]\s*)(?:sed\s+-i\b|perl\s+-pi\b|tee\b|touch\b|truncate\b|cp\b|mv\b|rm\b|patch\b|git\s+(?:apply|restore|rm|mv|checkout\s+--?)\b)/i;
  const outputRedirect = /(?:^|[^<])>>?\s*(?:["']?)(?:\.?\.?\/)?[A-Za-z0-9_.-]/m;
  const inlineInterpreter = /\b(?:python3?|node|ruby|perl|bash|sh)\s+(?:-c|-e)\b/i;
  return mutatingPrimitive.test(text) || outputRedirect.test(text) || inlineInterpreter.test(text);
}

// -----------------------------------------------------------------------------
// MAIN EXECUTION
// -----------------------------------------------------------------------------
function main() {

  
  let stdinBuffer = '';

  try {
    stdinBuffer = fs.readFileSync(0, 'utf8');
  } catch (_) {
    // Fail-safe exit 0 if stdin cannot be read
    process.exit(EXIT_ALLOW);
  }

  if (!stdinBuffer || !stdinBuffer.trim()) {
    // Fail-safe exit 0 on empty input
    process.exit(EXIT_ALLOW);
  }

  let data = null;
  try {
    data = JSON.parse(stdinBuffer);
  } catch (_) {
    // Fail-safe exit 0 on non-JSON input
    process.exit(EXIT_ALLOW);
  }

  if (!data || typeof data !== 'object') {
    process.exit(EXIT_ALLOW);
  }

  const toolName = data.tool_name || data.toolName || '';
  const isFileMutationTool = toolName === 'Write' || toolName === 'Edit';
  const isBashTool = toolName === 'Bash';
  if (!isFileMutationTool && !isBashTool) {
    process.exit(EXIT_ALLOW);
  }

  const toolInput = data.tool_input || data.toolInput || {};
  const agentId = data.agent_id || data.agentId || process.env.QCET_AGENT_ID || '';
  const agentType = data.agent_type || data.agentType || process.env.QCET_AGENT_TYPE || '';
  const agentRole = data.agent_role || data.agentRole || process.env.QCET_AGENT_ROLE || '';
  const subagentLabel = data.subagent_label || data.subagentLabel || data.label || '';
  const readOnly = isReadOnlyAgent(agentType, agentId, agentRole, subagentLabel);
  const builder = [agentType, agentRole, agentId, subagentLabel]
    .filter(Boolean)
    .some((value) => /builder|:implement|:repair/i.test(String(value)));

  const explicitCwd =
    data.cwd ||
    toolInput.cwd ||
    (data.execution_context && data.execution_context.cwd) ||
    process.env.QCET_WORKTREE_PATH ||
    '';

  if (isBashTool) {
    const command = toolInput.command || '';
    if (readOnly) {
      if (!isAllowedReadOnlyShellCommand(command)) {
        block(
          `Read-only agent '${agentType || agentId || subagentLabel}' attempted disallowed shell command: '${command}'. Only inspected read-only verification commands are permitted.`
        );
      }
      allow();
    }
    if (builder && isMutatingShellCommand(command)) {
      if (process.env.QCET_RUN_ID) {
        const projectDir = process.env.CLAUDE_PROJECT_DIR || process.cwd();
        const runDir = getRunDir(projectDir, process.env.QCET_RUN_ID);
        const shard = resolveActiveShard(agentId, agentType, subagentLabel);
        verifyWorktreeIdentity(runDir, shard, explicitCwd);
      }
      block(
        `Agent '${agentType || agentId || subagentLabel}' attempted shell file mutation. Use Write/Edit so shard ownership can be enforced deterministically.`
      );
    }
    process.exit(EXIT_ALLOW);
  }

  const rawPath =
    toolInput.file_path ||
    toolInput.filePath ||
    toolInput.path ||
    toolInput.notebook_path ||
    '';

  if (!rawPath) {
    process.exit(EXIT_ALLOW);
  }

  // 1. Prohibit read-only agents from writing or editing
  if (readOnly) {
    block(
      `Agent '${agentType || agentId || subagentLabel}' has a read-only role. Write and Edit tools are prohibited.`
    );
  }

  // 2. Resolve active shard ownership
  const shard = resolveActiveShard(agentId, agentType, subagentLabel);

  // 3. Executor run worktree and identity enforcement
  let runDir = null;
  let activeShardId = '';

  if (process.env.QCET_RUN_ID) {
    const projectDir = process.env.CLAUDE_PROJECT_DIR || process.cwd();
    runDir = getRunDir(projectDir, process.env.QCET_RUN_ID);
    const verified = verifyWorktreeIdentity(runDir, shard, explicitCwd);
    activeShardId = verified.shardId;
  }

  // Fail-closed invariant: builder agents MUST have an active shard ownership context
  if (!shard) {
    if (
      agentType === 'qcet-builder' ||
      agentRole === 'qcet-builder' ||
      String(agentType).toLowerCase().includes('builder')
    ) {
      block(
        `Builder agent '${agentType || agentId}' attempted file modification without an active shard ownership context (fail-closed boundary invariant).`
      );
    }
    // Fail-safe: if no active shard is mapped and not read-only or builder, allow (manual/interactive session)
    allow();
  }

  const targetFile = toRepoRelativePath(rawPath, explicitCwd);
  if (!targetFile) {
    allow();
  }

  // 4. Check antiOwns violations
  const antiOwns = Array.isArray(shard.antiOwns) ? shard.antiOwns : [];
  for (const pattern of antiOwns) {
    if (matchesOwnership(targetFile, pattern, explicitCwd)) {
      block(
        `Modification of '${targetFile}' is blocked. File violates antiOwns constraint '${pattern}' for shard '${shard.id || 'current'}'.`
      );
    }
  }

  // 5. Check owns scope (fail-closed: empty owns prohibits file modification)
  const owns = Array.isArray(shard.owns) ? shard.owns : [];
  if (owns.length === 0) {
    block(
      `Modification of '${targetFile}' is blocked. Shard '${shard.id || 'current'}' has no owned files assigned (fail-closed boundary invariant).`
    );
  }

  let hasOwnership = false;
  for (const pattern of owns) {
    if (matchesOwnership(targetFile, pattern, explicitCwd)) {
      hasOwnership = true;
      break;
    }
  }

  if (!hasOwnership) {
    block(
      `Modification of '${targetFile}' is blocked. File is outside assigned ownership scope for shard '${shard.id || 'current'}'. Allowed paths: [${owns.join(', ')}].`
    );
  }

  // 6. Atomic file claim lock in executor run
  if (runDir && activeShardId) {
    const claimRes = claimFile(runDir, activeShardId, targetFile);
    if (!claimRes.success) {
      block(
        `Modification of '${targetFile}' blocked: file is already claimed by shard '${claimRes.ownerShardId}'.`
      );
    }
  }

  // All ownership and lifecycle constraints satisfied
  allow();
}

if (require.main === module) {
  main();
} else {
  module.exports = {
    isAllowedReadOnlyShellCommand,
    isMutatingShellCommand,
    isReadOnlyAgent,
    resolveActiveShard,
  };
}
