#!/usr/bin/env bash
set -euo pipefail

# -----------------------------------------------------------------------------
# QCET Deterministic Hook: protect-sensitive-files
# Enforces zero access to sensitive secrets, .env files, private keys, and certs.
# -----------------------------------------------------------------------------

STDIN_DATA=""
if [ ! -t 0 ]; then
  STDIN_DATA=$(cat || true)
fi

TARGET=""
if [ $# -gt 0 ]; then
  TARGET="$*"
fi

TOOL_NAME=""
COMMAND=""
FILE_PATH=""

if [ -n "$STDIN_DATA" ]; then
  if echo "$STDIN_DATA" | jq -e . >/dev/null 2>&1; then
    TOOL_NAME=$(echo "$STDIN_DATA" | jq -r '.tool_name // empty' 2>/dev/null || true)
    FILE_PATH=$(echo "$STDIN_DATA" | jq -r '.tool_input.file_path // .tool_input.path // empty' 2>/dev/null || true)
    COMMAND=$(echo "$STDIN_DATA" | jq -r '.tool_input.command // empty' 2>/dev/null || true)
  else
    TARGET="${TARGET:-$STDIN_DATA}"
  fi
fi

VIOLATION=""

is_sensitive_file() {
  local f="$1"
  local base
  base=$(basename "$f")

  # Allow example and sample templates
  if [[ "$base" =~ \.(example|sample)$ ]] || [[ "$base" == ".env.example" ]] || [[ "$base" == ".env.sample" ]]; then
    return 1
  fi

  # Block .env, .env.*
  if [[ "$base" =~ ^\.env($|\..+) ]]; then
    return 0
  fi

  # Block *.pem, *.key, certificates, id_rsa, id_ed25519, credentials.json
  if [[ "$base" =~ \.(pem|key|pfx|p12|pkcs12)$ ]] || [[ "$base" =~ ^(id_rsa|id_ed25519|id_ecdsa|credentials\.json)$ ]]; then
    return 0
  fi

  return 1
}

# Check file path if present
if [ -n "$FILE_PATH" ]; then
  if is_sensitive_file "$FILE_PATH"; then
    VIOLATION="Access to sensitive credential file '$(basename "$FILE_PATH")' is strictly blocked by QCET security policy."
  fi
fi

# Check bash command if present
if [ -z "$VIOLATION" ] && [ -n "$COMMAND" ]; then
  # Filter out harmless example/sample files first
  CLEAN_CMD=$(echo "$COMMAND" | sed -E 's/\.env\.(example|sample)//g' | sed -E 's/[a-zA-Z0-9._-]+\.(example|sample)//g')
  if echo "$CLEAN_CMD" | grep -E '(^|[[:space:]"'"'"'/])(\.env(\.[a-zA-Z0-9._-]+)?|[^[:space:]"'"'"']+\.(pem|key|pfx|p12)|id_rsa|id_ed25519|credentials\.json)([[:space:]"'"'"']|$)' >/dev/null 2>&1; then
    VIOLATION="Bash command targets sensitive credentials or environment secrets: $COMMAND"
  fi
fi

# Check CLI argument target
if [ -z "$VIOLATION" ] && [ -n "$TARGET" ]; then
  if is_sensitive_file "$TARGET"; then
    VIOLATION="Access to sensitive credential target '$TARGET' is blocked by QCET security policy."
  fi
fi

if [ -n "$VIOLATION" ]; then
  >&2 echo "[QCET Security Policy] BLOCKED: $VIOLATION"
  cat <<EOF
{
  "continue": false,
  "stopReason": "$VIOLATION",
  "decision": "block",
  "reason": "$VIOLATION",
  "hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "permissionDecision": "deny",
    "permissionDecisionReason": "$VIOLATION"
  }
}
EOF
  exit 2
fi

exit 0
