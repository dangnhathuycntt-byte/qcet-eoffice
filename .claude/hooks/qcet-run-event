#!/usr/bin/env node

/**
 * QCET Run Event Logger Hook
 *
 * Records bounded SubagentStart, SubagentStop, PostToolUse, and PostToolUseFailure
 * lifecycle events to the durable run ledger (.claude/executor-runs/<runId>/events.jsonl)
 * only when QCET_RUN_ID is present.
 */

const fs = require('fs');
const path = require('path');
const { getRunDir, appendEvent } = require('./qcet-run-state.cjs');

function main() {
  const runId = process.env.QCET_RUN_ID;
  if (!runId || !runId.trim()) {
    process.exit(0);
  }

  let inputData = {};
  try {
    const raw = fs.readFileSync(0, 'utf8');
    if (raw && raw.trim()) {
      inputData = JSON.parse(raw);
    }
  } catch (_) {
    // Fail-safe exit on read/parse failure
    process.exit(0);
  }

  try {
    const projectDir = process.env.CLAUDE_PROJECT_DIR || process.cwd();
    const runDir = getRunDir(projectDir, runId);

    // Determine event type
    const eventType =
      inputData.hook_event_name ||
      inputData.hookEventName ||
      process.env.QCET_EVENT_TYPE ||
      (inputData.tool_name ? 'PostToolUse' : 'SubagentEvent');

    const record = {
      type: eventType,
      agentId: inputData.agent_id || inputData.agentId || process.env.QCET_AGENT_ID || '',
      agentType: inputData.agent_type || inputData.agentType || process.env.QCET_AGENT_TYPE || '',
      subagentLabel: inputData.subagent_label || inputData.subagentLabel || inputData.label || '',
      toolName: inputData.tool_name || inputData.toolName || '',
    };

    // Include bounded tool summary if applicable
    if (inputData.tool_input) {
      const ti = inputData.tool_input;
      if (ti.file_path || ti.filePath || ti.path) {
        record.path = String(ti.file_path || ti.filePath || ti.path).slice(0, 300);
      }
      if (ti.command) {
        record.command = String(ti.command).slice(0, 300);
      }
    }

    if (inputData.error || inputData.failure) {
      record.error = String(inputData.error || inputData.failure).slice(0, 500);
    }

    appendEvent(runDir, record);
  } catch (_) {
    // Hooks must never crash the Claude CLI harness
  }

  process.exit(0);
}

if (require.main === module) {
  main();
}
