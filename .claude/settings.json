{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git push*)",
      "Bash(npm run typecheck*)",
      "Bash(npm test*)",
      "Bash(npx tsx --test*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(*.env*)",
      "Read(**/.env*)",
      "Edit(.env*)",
      "Edit(*.env*)",
      "Edit(**/.env*)",
      "Write(.env*)",
      "Write(*.env*)",
      "Write(**/.env*)",
      "Read(*.pem)",
      "Read(**/*.pem)",
      "Edit(*.pem)",
      "Edit(**/*.pem)",
      "Write(*.pem)",
      "Write(**/*.pem)",
      "Read(*.key)",
      "Read(**/*.key)",
      "Edit(*.key)",
      "Edit(**/*.key)",
      "Write(*.key)",
      "Write(**/*.key)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)"
    ],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-sensitive-files\"",
            "statusMessage": "Verifying file safety..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-ownership-guard\"",
            "statusMessage": "Enforcing shard ownership invariants..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-next-build\"",
            "statusMessage": "Checking dev server port 3001 cache safety..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-sensitive-files\"",
            "statusMessage": "Verifying command safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/fast-changed-file-check\"",
            "statusMessage": "Linting changed files for QCET architectural invariants..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-stop-evidence-gate\"",
            "statusMessage": "Verifying subagent execution evidence..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
