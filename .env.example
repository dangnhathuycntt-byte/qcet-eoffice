# ==============================================================================
# QCET E-Office - Canonical Environment Configuration Template
# ==============================================================================
# Truong Cao dang Kinh te va Cong nghe Quy Nhon
#
# Copy this template to local environment file for development.
# NEVER commit real production secrets, credentials, or API keys to git.
# ==============================================================================

# ==============================================================================
# SECTION 1: SERVER-ONLY CONFIGURATION
# (Never exposed to browser bundles or client runtime)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1.1 Node & Server Runtime
# ------------------------------------------------------------------------------
# [REQUIRED] Application runtime environment: "development" | "production" | "test"
NODE_ENV=development

# [OPTIONAL] Internal HTTP server listen port (default: 3001)
PORT=3001

# ------------------------------------------------------------------------------
# 1.2 Database & Persistence (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# [REQUIRED in production, OPTIONAL in development]
# Standard PostgreSQL connection pool URL consumed by Prisma Client.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Development fallback: postgresql://localhost:5432/qcet_eoffice?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/qcet_dev?schema=public"

# Optional Docker Compose PostgreSQL credentials
POSTGRES_DB="qcet_eoffice"
POSTGRES_USER="qcet_admin"
POSTGRES_PASSWORD="your-strong-postgres-password-placeholder"

# ------------------------------------------------------------------------------
# 1.2b Distributed Rate Limiting (Shared Redis, Issue #29)
# ------------------------------------------------------------------------------
# [REQUIRED in production, OPTIONAL in development/tests]
# Shared rate-limit backend so limits hold across Next.js instances and app
# restarts. Point at self-hosted on-prem Redis (see `redis` service in
# docker-compose.yml). When unset, the app uses a process-local test double
# with identical semantics — suitable for local dev/unit tests ONLY.
# Production without REDIS_URL fails startup env validation, throws in the
# backend resolver, and reports readiness 503 (limiter fails closed).
# Local via compose: REDIS_URL="redis://localhost:6379"
# In compose network: REDIS_URL="redis://redis:6379"
#REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 1.3 Authentication & Session Security (JWT / Cookies)
# ------------------------------------------------------------------------------
# [REQUIRED in production, OPTIONAL in development]
# Primary cryptographic key for HMAC-SHA256 session token signing.
# MUST be at least 32 characters long in production.
# Generate a strong key using: openssl rand -base64 48
AUTH_SECRET="your-auth-secret-min-32-chars-long-placeholder-dev-only"

# [OPTIONAL] Legacy alias for AUTH_SECRET maintained for backward compatibility.
JWT_SECRET="your-auth-secret-min-32-chars-long-placeholder-dev-only"

# [OPTIONAL / RECOMMENDED in production]
# Server URL used for CSRF origin verification, OAuth callbacks, and cookie domain scoping.
NEXTAUTH_URL="http://localhost:3001"

# [OPTIONAL, Default: cdktcnqn.edu.vn]
# Comma-separated domain whitelist for Google Workspace Single Sign-On.
AUTH_ALLOWED_DOMAINS="cdktcnqn.edu.vn"

# ------------------------------------------------------------------------------
# 1.4 Google Workspace OAuth 2.0 Integration
# ------------------------------------------------------------------------------
# [OPTIONAL, REQUIRED if FEATURE_EXTERNAL_GOOGLE_LOGIN=true]
# Google Cloud Console OAuth 2.0 Client credentials for institutional SSO.
GOOGLE_CLIENT_ID="your-google-client-id-placeholder.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-placeholder"

# ------------------------------------------------------------------------------
# 1.5 Web Push Notifications (VAPID) Server Configuration
# ------------------------------------------------------------------------------
# [OPTIONAL, REQUIRED if FEATURE_FLAG_PUSH_NOTIFICATIONS=true]
# Generate VAPID keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key-placeholder"
VAPID_PRIVATE_KEY="your-vapid-private-key-placeholder"
VAPID_SUBJECT="mailto:admin@cdktcnqn.edu.vn"

# ------------------------------------------------------------------------------
# 1.6 Storage Subsystem & Local Filesystem Boundaries
# ------------------------------------------------------------------------------
# [OPTIONAL, Defaults to local project directories]
# UPLOADS_DIR: Directory for uploaded task deliverables and document attachments.
UPLOADS_DIR="./uploads"

# [OPTIONAL] Storage path on Windows Host when running containerized deployment
UPLOADS_HOST_PATH="D:/QCET-Eoffice-Data/uploads"

# [OPTIONAL] Private confidential storage for sealed institutional records
PRIVATE_STORAGE_DIR="./storage/private"

# [OPTIONAL] Ephemeral scratch storage for temporary file exports (purged within 24h)
TEMP_STORAGE_DIR="./storage/temp"

# ------------------------------------------------------------------------------
# 1.7 Legacy Integrations (Notion Read-Only Reference)
# ------------------------------------------------------------------------------
# [OPTIONAL] Read-only integration token for historical calendar import
NOTION_TOKEN=""
NOTION_LICH_LAM_VIEC_DB_ID=""
NOTION_HOAT_DONG_DB_ID=""

# ==============================================================================
# SECTION 2: CLIENT-EXPOSED CONFIGURATION (NEXT_PUBLIC_*)
# (Inlined into client JavaScript bundles at build time by Next.js compiler.
# NEVER put passwords, private keys, database URLs, or session secrets here!)
# ==============================================================================

# ------------------------------------------------------------------------------
# 2.1 Public URLs & Versioning
# ------------------------------------------------------------------------------
# [OPTIONAL, Default: http://localhost:3001]
# Canonical public base URL consumed by client PWA, service worker, and link generators.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# [OPTIONAL, Default: 1.0.0]
# Current release version string for telemetry and cache busting.
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2.2 Client-Side Integration Credentials
# ------------------------------------------------------------------------------
# [OPTIONAL, Must match GOOGLE_CLIENT_ID]
# Client-side Google OAuth Client ID for frontend Google Sign-In SDK.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id-placeholder.apps.googleusercontent.com"

# [OPTIONAL, Must match VAPID_PUBLIC_KEY]
# Client-side VAPID public key passed to browser PushManager.subscribe().
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key-placeholder"

# ------------------------------------------------------------------------------
# 2.3 Operational Simulation & Progressive Web App Controls
# ------------------------------------------------------------------------------
# [OPTIONAL, Format: YYYY-MM-DD]
# Overrides system date for academic semester/week simulation and audit testing.
# Keep empty in normal production usage.
NEXT_PUBLIC_REFERENCE_DATE=""

# [OPTIONAL, Default: false in development, true in production]
# Explicitly force Service Worker registration in local development.
NEXT_PUBLIC_ENABLE_SW="false"

# ==============================================================================
# SECTION 3: FEATURE FLAGS & RUNTIME TOGGLES
# ==============================================================================
# Feature flag toggles allow progressive rollout of capabilities without code deployment.
# Values accept "true" | "false" (or "1" | "0").

# Enable Web Push Notification service
FEATURE_FLAG_PUSH_NOTIFICATIONS="false"

# Enable Modern Task Workspace V2 interface
FEATURE_FLAG_TASK_WORKSPACE_V2="true"

# Enable Google Workspace SSO login button
FEATURE_EXTERNAL_GOOGLE_LOGIN="false"

# Enable Mobile Agenda view on PWA clients
NEXT_PUBLIC_FEATURE_FLAG_MOBILE_AGENDA="true"

# Agent soạn nháp nhiệm vụ trong hộp Tạo nhiệm vụ. Gateway chuẩn OpenAI (/chat/completions);
# nội dung chỉ đạo, danh sách nhân sự đơn vị và tệp/ảnh đính kèm (không lưu trên máy chủ) được gửi tới gateway này.
# [OPTIONAL, REQUIRED if FEATURE_TASK_AGENT=true]
FEATURE_TASK_AGENT="false"
TASK_AGENT_BASE_URL=""
TASK_AGENT_API_KEY=""
# Model mặc định cho Agent tạo nhiệm vụ và Trợ lý; người dùng chốt 21/10/2026 dùng "gemini-3.8-flash" ở mọi nơi.
TASK_AGENT_MODEL="gemini-3.8-flash"
# Ngân sách token suy nghĩ (>= 1024): gửi kèm `thinking` và nới `max_tokens` = ngân sách + 3000.
# "sonnet-4.6" chỉ trả reasoning khi có mục này; "gemini-3.8-flash" (gateway local, thử 17/10/2026) trả cả khi không có,
# nhưng vẫn nên đặt để phần suy nghĩ không ăn hết `max_tokens` 1200 mặc định. Gemini suy nghĩ bằng tiếng Anh.
# Ngân sách chỉ là trần: "65536" (dùng với gemini-3.8-flash) thực tế nghĩ ~1–1,5k token, chậm hơn 1024 vài giây.
TASK_AGENT_THINKING_BUDGET=""
# Model chọn được ở ô soạn của Agent tạo nhiệm vụ và Trợ lý (mã gateway, cách nhau dấu phẩy); lựa chọn nhớ theo trình duyệt,
# chung cho hai nơi. TASK_AGENT_MODEL luôn là model mặc định, đứng đầu; máy chủ từ chối model ngoài danh sách. Để trống thì
# chỉ có model mặc định và không hiện bộ chọn. Ví dụ: "sonnet-4.6,opus-4.6,gemini-3.8-flash" (Opus chậm và tốn hơn). [OPTIONAL]
TASK_AGENT_MODELS=""

# Trang Trợ lý (/assistant): hỏi đáp chỉ đọc trong quyền người hỏi, lịch sử chat lưu 90 ngày (ASSISTANT_RETENTION_DAYS).
# Dùng chung gateway TASK_AGENT_* (cần đủ BASE_URL, API_KEY, MODEL). Dữ liệu nhiệm vụ/văn bản THUONG mà người hỏi được xem
# sẽ được gửi tới gateway; văn bản mật và văn bản hạn chế không gửi. Ảnh/tệp người hỏi đính kèm (cùng loại, giới hạn
# như Agent tạo nhiệm vụ, tính theo lượt) chỉ gửi gateway trong lượt đó, không lưu trên máy chủ. [OPTIONAL]
FEATURE_ASSISTANT="false"

# Ghi âm cuộc họp (chép lời và biên bản đề xuất, ADR-013): dùng chung gateway TASK_AGENT_* (cần đủ BASE_URL, API_KEY, MODEL)
# nhưng model riêng nghe được âm thanh; mặc định gemini-3.8-flash. Âm thanh cuộc họp và tiêu đề cuộc họp được gửi tới gateway;
# âm thanh lưu tạm ở UPLOADS_DIR/recordings và bị xóa khi xử lý xong. Gateway phải nhận phần "file" dạng data URI. [OPTIONAL]
MEETING_AUDIO_MODEL=""
# ffmpeg (cần libmp3lame) để cắt từng đoạn 6 phút trước khi gửi: nhận bản ghi tới 128 MB / 4 giờ. Không đặt thì dùng "ffmpeg"
# trong PATH, đặt đường dẫn để dùng bản khác, "none" để tắt (khi đó gửi cả tệp mỗi đoạn, chỉ nhận tới 48 MB). [OPTIONAL]
MEETING_AUDIO_FFMPEG=""
# "off" tắt đường nhanh (gửi cả bản ghi một lần để nhận thẳng biên bản), luôn chép từng đoạn rồi mới soạn: dùng khi gateway
# không nhận được thân yêu cầu lớn (đã thử ≈44 MB). Để trống thì bật. [OPTIONAL]
MEETING_AUDIO_DIRECT=""

# ==============================================================================
# SECTION 4: DATABASE SEEDING
# ==============================================================================
# [OPTIONAL in development, REQUIRED when NODE_ENV=production]
# Mật khẩu cho các tài khoản do `npm run db:seed` tạo.
# Không đặt giá trị thật vào file này hay vào bất kỳ commit nào.
# - SEED_DEFAULT_PASSWORD: mật khẩu cho tài khoản nhân sự mẫu.
# - SEED_BGH_PASSWORD:     mật khẩu cho tài khoản Ban Giám hiệu (bgh@...).
SEED_DEFAULT_PASSWORD=""
SEED_BGH_PASSWORD=""

# ------------------------------------------------------------------------------
# Hai ứng dụng web + api (apps/web, apps/api)
# ------------------------------------------------------------------------------
# Web gọi API ở đây khi render ở server, và chuyển tiếp /api của trình duyệt tới đây (rewrites, chốt khi build).
# Bắt buộc khi build/chạy production của web. Dev bỏ trống: http://127.0.0.1:${API_PORT}. Docker: http://qcet-api:3000.
API_INTERNAL_URL=
# Cổng dev của api (`npm run dev` chạy api ở cổng này, web ở PORT/-p, mặc định 3000)
API_PORT=3100
# Tên dịch vụ ghi vào trường "service" của log có cấu trúc (compose đặt qcet-api / qcet-web)
SERVICE_NAME=

# Worker outbox (chỉ qcet-api; bật bằng OUTBOX_WORKER_ENABLED=true)
# Chu kỳ quét outbox (ms), mặc định 60000
OUTBOX_POLL_INTERVAL_MS=
# Lease (ms): sự kiện PROCESSING lâu hơn mức này được trả về PENDING (worker chết giữa chừng), mặc định 600000.
# Phải lớn hơn AGENT_JOB_TIMEOUT_MS.
OUTBOX_LEASE_MS=
# Thời gian tối đa một việc nền của agent (ms, AbortSignal), mặc định 300000
AGENT_JOB_TIMEOUT_MS=
