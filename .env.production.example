# ==============================================================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU POSTGRESQL (PRODUCTION)
# ==============================================================================
POSTGRES_DB="qcet_eoffice"
POSTGRES_USER="qcet_admin"
# Vui lòng thay đổi mật khẩu mạnh trước khi triển khai thực tế
POSTGRES_PASSWORD=""

# Tài khoản qcet_admin chỉ dùng cho bootstrap/migration, không chạy ứng dụng.
MIGRATION_DATABASE_URL="postgresql://qcet_admin:<POSTGRES_PASSWORD>@qcet-db:5432/qcet_eoffice?schema=public"

# Chuỗi kết nối runtime bắt buộc phải dùng role qcet_app ít đặc quyền.
# Thay mật khẩu bằng giá trị thật và URL-encode ký tự đặc biệt (vd: # -> %23).
APP_DATABASE_URL="postgresql://qcet_app:<APP_DATABASE_PASSWORD>@qcet-db:5432/qcet_eoffice?schema=public"

# ==============================================================================
# CẤU HÌNH BẢO MẬT XÁC THỰC & PHIÊN LÀM VIỆC (JWT / SESSION)
# ==============================================================================
# [BẮT BUỘC] Sinh khóa mới bằng lệnh: openssl rand -base64 48
# TUYỆT ĐỐI KHÔNG dùng giá trị mẫu hay giá trị từng commit trong git.
# Mọi phiên đăng nhập đều có thể bị giả mạo nếu khóa này bị lộ hoặc để mặc định.
JWT_SECRET=""
AUTH_SECRET=""

# ==============================================================================
# TÊN MIỀN & GIAO THỨC CHÍNH THỨC
# ==============================================================================
NEXTAUTH_URL="https://e-office.cdktcnqn.edu.vn"
NEXT_PUBLIC_APP_URL="https://e-office.cdktcnqn.edu.vn"

# ==============================================================================
# ĐƯỜNG DẪN BỘ LƯU TRỮ VẬT LÝ TRÊN MÁY CHỦ WINDOWS HOST
# ==============================================================================
UPLOADS_HOST_PATH="D:/QCET-Eoffice-Data/uploads"
UPLOADS_DIR="/app/uploads"

# ==============================================================================
# CẤU HÌNH GOOGLE WORKSPACE OAUTH 2.0 (@cdktcnqn.edu.vn)
# ==============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_ALLOWED_DOMAINS="cdktcnqn.edu.vn"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ==============================================================================
# CẤU HÌNH WEB PUSH NOTIFICATIONS (VAPID CREDENTIALS - BẮT BUỘC TRÊN PRODUCTION)
# Sinh cặp khóa bằng lệnh: npx web-push generate-vapid-keys
# ==============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@cdktcnqn.edu.vn"
