{
  "name": "@qcet/api",
  "version": "0.1.0",
  "private": true,
  "description": "API QCET E-Office (route handler /api/*, dịch vụ, phân quyền, worker, cron). Nơi duy nhất chạm DB, Redis, ClamAV, tệp tải lên.",
  "scripts": {
    "dev": "cd ../.. && next dev --turbopack apps/api -p 3100",
    "build": "next build",
    "start": "cd ../.. && next start apps/api -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-tests.mjs --workspace apps/api",
    "eval:assistant": "tsx scripts/assistant-eval.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hocuspocus/server": "^3.4.4",
    "@next/env": "^15.5.27",
    "@prisma/client": "^6.19.3",
    "@qcet/contracts": "*",
    "@qcet/db": "*",
    "@qcet/shared": "*",
    "@slate-yjs/core": "^1.0.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "next": "^15.5.27",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^3.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2"
  }
}
