@@ -0,0 +1,31 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { VerifyAttendanceSchema } from "../../src/contracts/meeting";
+import { validateMeetingQuorum } from "../../src/lib/services/meeting-service";
+
+test("VerifyAttendanceSchema validates input correctly", () => {
+  const valid = VerifyAttendanceSchema.safeParse({
+    meetingId: "m1",
+    participantId: "p1",
+    status: "PRESENT",
+    verifiedAt: new Date().toISOString(),
+    verifiedBy: "u1"
+  });
+  assert.equal(valid.success, true);
+});
+
+test("validateMeetingQuorum enforces 50% attendance quorum", () => {
+  const quorumPass = validateMeetingQuorum("m1", [
+    { id: "1", status: "PRESENT" },
+    { id: "2", status: "ABSENT" }
+  ]);
+  assert.equal(quorumPass.hasQuorum, true);
+  assert.equal(quorumPass.ratio, 0.5);
+
+  const quorumFail = validateMeetingQuorum("m2", [
+    { id: "1", status: "PRESENT" },
+    { id: "2", status: "ABSENT" },
+    { id: "3", status: "ABSENT" }
+  ]);
+  assert.equal(quorumFail.hasQuorum, false);
+});
