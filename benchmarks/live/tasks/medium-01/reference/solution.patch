@@ -0,0 +1,33 @@
+export interface MeetingQuorumResult {
+  hasQuorum: boolean;
+  ratio: number;
+  presentCount: number;
+  totalCount: number;
+}
+
+export function validateMeetingQuorum(
+  meetingId: string,
+  participants: Array<{ id: string; status: string }>
+): MeetingQuorumResult {
+  if (!participants || participants.length === 0) {
+    return {
+      hasQuorum: false,
+      ratio: 0,
+      presentCount: 0,
+      totalCount: 0,
+    };
+  }
+
+  const presentCount = participants.filter(
+    (p) => p.status === "PRESENT" || p.status === "EXCUSED"
+  ).length;
+  const totalCount = participants.length;
+  const ratio = presentCount / totalCount;
+
+  return {
+    hasQuorum: ratio >= 0.5,
+    ratio,
+    presentCount,
+    totalCount,
+  };
+}
