--- /dev/null
+++ b/tests/unit/academic-calendar.test.ts
@@ -0,0 +1,13 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { isOperationalMonthBoundary, getAcademicMonthInfo } from "../../src/lib/academic-calendar";
+
+test("isOperationalMonthBoundary detects cycle boundaries", () => {
+  assert.deepEqual(isOperationalMonthBoundary("2026-08-25"), { isStart: true, isEnd: false });
+  assert.deepEqual(isOperationalMonthBoundary("2026-08-24"), { isStart: false, isEnd: true });
+  assert.deepEqual(isOperationalMonthBoundary("2026-08-15"), { isStart: false, isEnd: false });
+});
+
+test("isOperationalMonthBoundary handles UTC offset", () => {
+  assert.deepEqual(isOperationalMonthBoundary("2026-08-24T18:00:00Z"), { isStart: true, isEnd: false });
+});
