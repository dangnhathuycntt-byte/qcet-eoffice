{
  "name": "qcet-eoffice",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @qcet/api",
    "dev:web": "npm run dev -w @qcet/web",
    "build": "npm run build -w @qcet/api && npm run build -w @qcet/web",
    "build:standalone": "npm run build",
    "start": "node scripts/dev.mjs --start",
    "lint": "node scripts/lint.mjs && node scripts/check-orphans.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:changed": "node scripts/run-tests.mjs --pattern changed",
    "test:smoke": "node scripts/run-tests.mjs --pattern smoke",
    "test:unit": "node scripts/run-tests.mjs --pattern unit",
    "test:security": "node scripts/run-tests.mjs --pattern security",
    "test:domain": "node scripts/run-tests.mjs --pattern domain",
    "test:critical": "node scripts/run-tests.mjs --pattern critical",
    "test:integration": "node scripts/run-tests.mjs --pattern integration",
    "test:full": "node scripts/run-tests.mjs",
    "test:gate0": "node scripts/run-gate0.mjs",
    "test:sprint2": "node scripts/run-sprint2.mjs",
    "test:sprint3": "node scripts/run-sprint3.mjs",
    "test:e2e": "playwright test",
    "smoke:split": "node scripts/smoke-split.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "verify": "npm run typecheck && npm run lint && npm test",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "db:migrate:status": "prisma migrate status",
    "db:drift:check": "node scripts/db-drift-check.mjs",
    "db:migrate:test-fresh": "node scripts/db-migrate-test-fresh.mjs",
    "db:migrate:test-upgrade": "node scripts/db-migrate-test-upgrade.mjs",
    "files:backfill": "tsx scripts/backfill-file-objects.ts",
    "files:scan-pending": "tsx scripts/scan-pending-file-objects.ts",
    "db:backup:drill": "node scripts/backup-restore-drill.mjs",
    "eval:assistant": "npm run eval:assistant -w @qcet/api --"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@platejs/autoformat": "^53.0.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "react-resizable-panels": "^4.12.4"
  },
  "devDependencies": {
    "@next/env": "^15.5.27",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.17.19",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma",
    "seed": "tsx packages/db/prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.2",
    "sharp": ">=0.35.5"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  }
}
