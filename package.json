{
  "name": "qcet-eoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:standalone": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:gate0": "node scripts/run-gate0.mjs",
    "test:sprint2": "node scripts/run-sprint2.mjs",
    "test:sprint3": "node scripts/run-sprint3.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "db:seed": "tsx prisma/seed.ts",
