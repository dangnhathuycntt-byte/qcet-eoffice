    "db:drift:check": "node scripts/db-drift-check.mjs",
    "db:migrate:test-fresh": "node scripts/db-migrate-test-fresh.mjs",
    "db:migrate:test-upgrade": "node scripts/db-migrate-test-upgrade.mjs",
    "db:backup:drill": "node scripts/backup-restore-drill.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "motion": "^13.2.0",
    "next": "^15.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
