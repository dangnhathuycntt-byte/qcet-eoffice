datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  BAN_GIAM_HIEU
  TRUONG_PHONG
  CHUYEN_VIEN
  VAN_THU
  ADMIN
}

enum DocumentType {
  VAN_BAN_DEN
  VAN_BAN_DI
  TO_TRINH_NOI_BO
}

enum DocumentUrgency {
  THUONG
  KHAN
  THUONG_KHAN
  HOA_TOC
}

enum DocumentSecurityLevel {
  THUONG
  MAT
  TOI_MAT
  TUYET_MAT
}

enum DocumentStatus {
  CHO_PHAN_CONG
  DANG_XU_LY
  CHO_PHE_DUYET
  DA_HOAN_THANH
  LUU_THEO_DOI
}

enum TaskScope {
  SCHOOL
  DEPARTMENT
  INDIVIDUAL
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum DeliverableReviewStatus {
  PENDING
  APPROVED
  REVISION_REQUIRED
}

enum ResolutionType {
  EXTEND_DEADLINE
  REASSIGN_OWNER
  DIRECTIVE_NOTE
  DISMISS_BOTTLENECK
}


model User {
  id                    String                @id @default(cuid())
  email                 String                @unique @db.VarChar(255)
  name                  String                @db.VarChar(255)
  passwordHash          String?               @map("password_hash")
  role                  UserRole              @default(CHUYEN_VIEN)
  title                 String?               @db.VarChar(150)
  phone                 String?               @db.VarChar(20)
  avatarUrl             String?               @map("avatar_url")
  emailVerified         DateTime?             @map("email_verified")
  provider              String                @default("credentials") @db.VarChar(50)
  isActive              Boolean               @default(true) @map("is_active")
  deactivatedAt         DateTime?             @map("deactivated_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  onboardedAt           DateTime?             @map("onboarded_at")
  onboardingData        Json?                 @map("onboarding_data")

  accounts              Account[]
  sessions              Session[]
  tasksCreated          Task[]                @relation("TaskCreatedBy")
  archivedTasks         Task[]                @relation("TaskArchiver")
  deliverablesUploaded  TaskDeliverable[]     @relation("DeliverableUploadedBy")
  deliverablesReviewed  TaskDeliverable[]     @relation("DeliverableReviewer")
  resolutionsEnacted    ExecutiveResolution[] @relation("ResolutionActor")
  leadDocs              Document[]            @relation("LeadUserDocs")
  docsRegistered        Document[]            @relation("DocRegisteredBy")
  archivedDocuments     Document[]            @relation("DocumentArchiver")
  leaderDirectives      DocumentDirective[]   @relation("LeaderDirectives")
  pushSubscriptions     PushSubscription[]
  notifications         Notification[]
  positionAssignments   PositionAssignment[]  @relation("UserPositionAssignments")
  bodyMemberships       BodyMembership[]
  taskActors            TaskActor[]
  assignedActors        TaskActor[]           @relation("ActorAssignedBy")
  taskApprovalSteps     TaskApprovalStep[]
  taskResultsSubmitted  TaskResult[]          @relation("TaskResultSubmitter")
  taskResultsVerified   TaskResult[]          @relation("TaskResultVerifier")
  workflowsPresented    DocumentIncomingWorkflow[] @relation("DocWorkflowPresentedBy")
  workflowsDirected     DocumentIncomingWorkflow[] @relation("DocWorkflowLeader")
  workflowsResolved     DocumentIncomingWorkflow[] @relation("DocWorkflowResolvedBy")
  workflowsFiled        DocumentIncomingWorkflow[] @relation("DocWorkflowFiledBy")
  workflowsArchived     DocumentIncomingWorkflow[] @relation("DocWorkflowArchivedBy")
  unitAssignmentsGiven  UnitWorkAssignment[]       @relation("UnitWorkAssignedBy")
  unitAssignmentsDri    UnitWorkAssignment[]       @relation("UnitWorkDri")
  signatures                         SignatureRecord[]          @relation("UserSignatures")
  outgoingWorkflowsContentReviewed   DocumentOutgoingWorkflow[] @relation("DocWorkflowContentReviewer")
  outgoingWorkflowsFormatReviewed    DocumentOutgoingWorkflow[] @relation("DocWorkflowFormatReviewer")
  outgoingWorkflowsAuthorizedSigned  DocumentOutgoingWorkflow[] @relation("DocWorkflowAuthorizedSigner")
  outgoingWorkflowsNumbered          DocumentOutgoingWorkflow[] @relation("DocWorkflowNumberer")
  outgoingWorkflowsOrgSigned         DocumentOutgoingWorkflow[] @relation("DocWorkflowOrgSigner")
  outgoingWorkflowsIssued            DocumentOutgoingWorkflow[] @relation("DocWorkflowIssuer")
  outgoingWorkflowsFiled             DocumentOutgoingWorkflow[] @relation("DocWorkflowOutgoingFiledBy")
  outgoingWorkflowsArchived          DocumentOutgoingWorkflow[] @relation("DocWorkflowOutgoingArchivedBy")
  dossiersResponsible               WorkDossier[]              @relation("DossierResponsiblePerson")
  dossiersSubmitted                 WorkDossier[]              @relation("DossierSubmittedBy")
  dossiersArchived                  WorkDossier[]              @relation("DossierArchivedBy")
  dossierItemsAdded                 DossierItem[]              @relation("DossierItemAddedBy")
  organizedMeetings                 Meeting[]                  @relation("MeetingOrganizer")
  meetingParticipations             MeetingParticipant[]
  meetingResolutionsLead            MeetingResolution[]        @relation("MeetingResolutionLead")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique @map("session_token")
  userId       String    @map("user_id")
  expires      DateTime
  revokedAt    DateTime? @map("revoked_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Task {
  id              String                @id @default(cuid())
  code            String                @unique @db.VarChar(50)
  title           String                @db.VarChar(500)
  description     String?               @db.Text
  scope           TaskScope             @default(SCHOOL)
  status          TaskStatus            @default(NOT_STARTED)
  priority        TaskPriority          @default(NORMAL)
  progressPercent Int                   @default(0) @map("progress_percent")
  academicMonth   Int                   @map("academic_month")
  academicYear    String                @map("academic_year") @db.VarChar(20)
  startDate       DateTime              @default(now()) @map("start_date")
  dueDate         DateTime              @map("due_date")
  completedAt     DateTime?             @map("completed_at")
  createdById     String                @map("created_by_id")
  createdBy       User                  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  parentTaskId    String?               @map("parent_task_id")
  parentTask      Task?                 @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks        Task[]                @relation("SubTasks")
  deliverables    TaskDeliverable[]
  resolutions     ExecutiveResolution[]
  linkedDocument  Document?
  dacumTaskDefId  String?               @map("dacum_task_def_id") @db.VarChar(50)
  dacumTaskDef    DacumTaskDef?         @relation(fields: [dacumTaskDefId], references: [id], onDelete: SetNull)
  archivedAt          DateTime?             @map("archived_at")
  archivedById        String?               @map("archived_by_id")
  archiveReason       String?               @map("archive_reason") @db.Text
  archivedBy          User?                 @relation("TaskArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  originLevel         TaskOriginLevel       @default(SCHOOL) @map("origin_level")
  leadUnitId          String?               @map("lead_unit_id")
  leadUnit            OrganizationalUnit?   @relation("TaskLeadUnit", fields: [leadUnitId], references: [id], onDelete: SetNull)
  primaryAssignmentId String?               @map("primary_assignment_id")
  primaryAssignment   PositionAssignment?   @relation("TaskPrimaryAssignment", fields: [primaryAssignmentId], references: [id], onDelete: SetNull)
  actors              TaskActor[]
  approvalProcesses   TaskApprovalProcess[]
  taskResults         TaskResult[]
  unitAssignments     UnitWorkAssignment[]  @relation("UnitWorkTask")
  sourceRelations     TaskRelation[]        @relation("SourceTaskRelations")
  targetRelations     TaskRelation[]        @relation("TargetTaskRelations")
  meetingResolutions  MeetingResolution[]
  version             Int                   @default(1) @map("version")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([academicYear])
  @@index([status, dueDate])
  @@index([scope, status, dueDate])
  @@index([parentTaskId])
  @@index([createdById])
  @@index([updatedAt(sort: Desc)])
  @@index([scope, priority])
  @@index([leadUnitId])
  // Phase 9: thay thế `tasks_department_id_status_due_date_idx` đã bị drop —
  // đơn vị canonical của nhiệm vụ là `leadUnitId`.
  @@index([leadUnitId, status, dueDate])
  @@index([primaryAssignmentId])
  @@map("tasks")
}

model TaskDeliverable {
  id           String                  @id @default(cuid())
  taskId       String                  @map("task_id")
  title        String                  @db.VarChar(255)
  fileUrl      String                  @map("file_url") @db.Text
  fileType     String?                 @map("file_type") @db.VarChar(50)
  fileSize     Int?                    @map("file_size")
  uploadedById String                  @map("uploaded_by_id")
  reviewStatus DeliverableReviewStatus @default(PENDING) @map("review_status")
  reviewerId   String?                 @map("reviewer_id")
  reviewNote   String?                 @map("review_note") @db.Text
  reviewedAt   DateTime?               @map("reviewed_at")
  task         Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User                    @relation("DeliverableUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewer     User?                   @relation("DeliverableReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@index([taskId, reviewStatus])
  @@map("task_deliverables")
}

model ExecutiveResolution {
  id              String         @id @default(cuid())
  taskId          String         @map("task_id")
  actorId         String         @map("actor_id")
  resolutionType  ResolutionType @map("resolution_type")
  directiveNote   String?        @map("directive_note") @db.Text
  grantedDays     Int?           @map("granted_days")
  previousDueDate DateTime?      @map("previous_due_date")
  newDueDate      DateTime?      @map("new_due_date")
  previousOwnerId String?        @map("previous_owner_id")
  newOwnerId      String?        @map("new_owner_id")
  task            Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor           User           @relation("ResolutionActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([taskId, resolutionType])
  @@map("executive_resolutions")
}

// ===================================================
// 1. BẢNG SỔ VĂN BẢN (DOCUMENTS)
// Đáp ứng đồng thời Phụ lục IV và Phụ lục VI NĐ 30/2020
// ===================================================
model Document {
  id                 String                @id @default(cuid())
  type               DocumentType          @map("type")

  // Thông tin đăng ký sổ (Số đến hoặc Số đi liên tục theo năm)
  registrationNumber Int                   @map("registration_number")
  documentYear       Int                   @map("document_year")
  registeredDate     DateTime              @default(now()) @map("registered_date")

  // Thông tin văn bản gốc
  originalNumber     String                @map("original_number") @db.VarChar(100)
  issuedDate         DateTime              @map("issued_date")
  issuingAuthority   String                @map("issuing_authority") @db.VarChar(255)

  // Trích yếu nội dung & Phân loại hành chính
  category           String                @db.VarChar(100)
  summary            String                @db.Text
  urgency            DocumentUrgency       @default(THUONG)
  securityLevel      DocumentSecurityLevel @default(THUONG) @map("security_level")

  // Các trường đặc thù Văn bản Đi (Phụ lục IV Mẫu Sổ Văn bản Đi)
  signerName         String?               @map("signer_name") @db.VarChar(150)
  signerTitle        String?               @map("signer_title") @db.VarChar(100)
  recipientList      String?               @map("recipient_list") @db.Text
  distributedCopies  Int?                  @default(1) @map("distributed_copies")

  // Các trường đặc thù Văn bản Đến (Phụ lục IV Mẫu Sổ Văn bản Đến)
  dueDate            DateTime?             @map("due_date")
  leadUserId         String?               @map("lead_user_id")
  leadUser           User?                 @relation("LeadUserDocs", fields: [leadUserId], references: [id], onDelete: SetNull)

  // Trạng thái vòng đời văn bản
  status             DocumentStatus        @default(CHO_PHAN_CONG)
  notes              String?               @db.Text

  // Văn thư thực hiện vào sổ
  registeredById     String                @map("registered_by_id")
  registeredBy       User                  @relation("DocRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)

  // Lưu trữ & Hủy/Lưu trữ vòng đời
  archivedAt         DateTime?             @map("archived_at")
  archivedById       String?               @map("archived_by_id")
  archiveReason      String?               @map("archive_reason") @db.Text
  archivedBy         User?                 @relation("DocumentArchiver", fields: [archivedById], references: [id], onDelete: SetNull)

  // Quan hệ tệp đính kèm & Bút phê BGH
  attachments        DocumentAttachment[]
  directives         DocumentDirective[]
  incomingWorkflow   DocumentIncomingWorkflow?
  outgoingWorkflow   DocumentOutgoingWorkflow?
  signatures         SignatureRecord[]

  // Liên thông Unified Task Hub
  linkedTaskId       String?               @unique @map("linked_task_id")
  linkedTask         Task?                 @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  version            Int                   @default(1) @map("version")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@unique([type, documentYear, registrationNumber])
  @@index([type, documentYear, registeredDate])
  @@index([type, status, dueDate])
  @@index([status, urgency, dueDate])
  @@index([originalNumber])
  @@map("documents")
}

// ===================================================
// 2. BỘ ĐẾM SỐ TỰ ĐỘNG ATOMIC (NUMBER SEQUENCE)
// Đảm bảo nguyên tắc cấp số liên tục Điều 15 & Điều 22
// ===================================================
model DocumentNumberSequence {
  id         String       @id @default(cuid())
  type       DocumentType
  year       Int
  lastNumber Int          @default(0) @map("last_number")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([type, year])
  @@map("document_number_sequences")
}

// ===================================================
// 3. TỆP ĐÍNH KÈM SỐ HÓA (ATTACHMENTS)
// Tiêu chuẩn scan màu PDF/A có dấu đỏ (Phụ lục I NĐ 30)
// ===================================================
model DocumentAttachment {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  fileUrl    String   @map("file_url") @db.Text
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sha256Hash String?  @map("sha256_hash") @db.VarChar(64)
  isOriginal Boolean  @default(true) @map("is_original")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("document_attachments")
}

// ===================================================
// 4. BÚT PHÊ & Ý KIẾN CHỈ ĐẠO BGH (DIRECTIVES)
// Quy chuẩn Điều 24 NĐ 30
// ===================================================
model DocumentDirective {
  id               String      @id @default(cuid())
  documentId       String      @map("document_id")
  leaderId         String      @map("leader_id")
  instruction      String      @db.Text
  deadline         DateTime?
  // Phase 9: `assignedDeptId` (legacy `Department` FK) was dropped in migration
  // 20260923000002_drop_department. The unit receiving a directive is the lead
  // unit of the task the directive generated (`Task.leadUnitId`, reached through
  // `Document.linkedTaskId`).
  collaboratorIds  String?     @map("collaborator_ids") @db.Text
  isTaskGenerated  Boolean     @default(false) @map("is_task_generated")

  document         Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  leader           User        @relation("LeaderDirectives", fields: [leaderId], references: [id], onDelete: Restrict)
  version          Int         @default(1) @map("version")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([documentId, leaderId])
  @@map("document_directives")
}

// ===================================================
// 4B. VÒNG ĐỜI VĂN BẢN ĐẾN & PHÂN CÔNG TÁC NGHIỆP 2 CẤP
// Tiêu chuẩn Nghị định 30/2020/NĐ-CP & Mô hình Điều hành QCET
// ===================================================
enum IncomingDocumentStatus {
  RECEIVED
  REGISTERED
  PRESENTED
  DIRECTED
  ASSIGNED_TO_LEAD_UNIT
  UNIT_ASSIGNED_PERSON
  IN_PROGRESS
  RESOLVED
  FILED
  ARCHIVED
}

model DocumentIncomingWorkflow {
  id                    String                 @id @default(cuid())
  documentId            String                 @unique @map("document_id")
  document              Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status                IncomingDocumentStatus @default(REGISTERED)

  // Presentation (Trình Lãnh đạo)
  presentedAt           DateTime?              @map("presented_at")
  presentedById         String?                @map("presented_by_id")
  presentedBy           User?                  @relation("DocWorkflowPresentedBy", fields: [presentedById], references: [id], onDelete: SetNull)
  presenterNotes        String?                @map("presenter_notes") @db.Text

  // Leadership Direction (Tier 1: BGH chỉ đạo)
  directedAt            DateTime?              @map("directed_at")
  leaderId              String?                @map("leader_id")
  leader                User?                  @relation("DocWorkflowLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  leadUnitId            String?                @map("lead_unit_id")
  leadUnit              OrganizationalUnit?    @relation("DocWorkflowLeadUnit", fields: [leadUnitId], references: [id], onDelete: SetNull)
  coordinatingUnitIds   Json?                  @map("coordinating_unit_ids")
  leadershipInstruction String?                @map("leadership_instruction") @db.Text
  deadline              DateTime?              @map("deadline")
  responsibilityAreaId  String?                @map("responsibility_area_id")
  responsibilityArea    ResponsibilityArea?    @relation("DocWorkflowRespArea", fields: [responsibilityAreaId], references: [id], onDelete: SetNull)

  // Tier 2: Unit Work Assignment (Trưởng đơn vị phân công)
  unitAssignments       UnitWorkAssignment[]

  // Resolution (Giải quyết xong)
  resolvedAt            DateTime?              @map("resolved_at")
  resolvedById          String?                @map("resolved_by_id")
  resolvedBy            User?                  @relation("DocWorkflowResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionSummary     String?                @map("resolution_summary") @db.Text
  resolutionDocUrl      String?                @map("resolution_doc_url") @db.Text

  // Filing / Archival (Lập hồ sơ / Lưu trữ)
  filedAt               DateTime?              @map("filed_at")
  filedById             String?                @map("filed_by_id")
  filedBy               User?                  @relation("DocWorkflowFiledBy", fields: [filedById], references: [id], onDelete: SetNull)
  dossierId             String?                @map("dossier_id") @db.VarChar(100)
  filingNotes           String?                @map("filing_notes") @db.Text

  archivedAt            DateTime?              @map("archived_at")
  archivedById          String?                @map("archived_by_id")
  archivedBy            User?                  @relation("DocWorkflowArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([status])
  @@index([leadUnitId])
  @@index([leaderId])
  @@map("document_incoming_workflows")
}

model UnitWorkAssignment {
  id                  String                   @id @default(cuid())
  workflowId          String                   @map("workflow_id")
  workflow            DocumentIncomingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  unitId              String                   @map("unit_id")
  unit                OrganizationalUnit       @relation("UnitWorkAssignmentUnit", fields: [unitId], references: [id], onDelete: Restrict)
  assignedById        String                   @map("assigned_by_id")
  assignedBy          User                     @relation("UnitWorkAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  driUserId           String                   @map("dri_user_id")
  driUser             User                     @relation("UnitWorkDri", fields: [driUserId], references: [id], onDelete: Restrict)
  collaboratorUserIds Json?                    @map("collaborator_user_ids")

  instruction         String?                  @db.Text
  deadline            DateTime?
  status              String                   @default("ASSIGNED") @db.VarChar(50)

  // Link to generated task if any
  taskId              String?                  @map("task_id")
  task                Task?                    @relation("UnitWorkTask", fields: [taskId], references: [id], onDelete: SetNull)

  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@index([workflowId])
  @@index([unitId])
  @@index([driUserId])
  @@map("unit_work_assignments")
}

// ===================================================
// 4B. OUTGOING DOCUMENTS V2 & DIGITAL SIGNATURES (NĐ 30/2020 & NĐ 68/2024)
// ===================================================
enum OutgoingDocumentStatus {
  DRAFT
  CONTENT_REVIEW
  FORMAT_CHECK
  AUTHORIZED_SIGN
  NUMBERED
  ORGANIZATION_SIGNED
  ISSUED
  DELIVERED
  FILED
  ARCHIVED
}

enum SignatureType {
  PERSONAL_DIGITAL
  ORGANIZATION_DIGITAL
  PHYSICAL
}

enum SignatureVerificationStatus {
  VALID
  INVALID
  REVOKED
  UNVERIFIED
}

model DocumentOutgoingWorkflow {
  id                        String                 @id @default(cuid())
  documentId                String                 @unique @map("document_id")
  document                  Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status                    OutgoingDocumentStatus @default(DRAFT)
  currentVersion            Int                    @default(1) @map("current_version")

  // Content Review (Phê duyệt nội dung)
  contentReviewSubmittedAt  DateTime?              @map("content_review_submitted_at")
  contentReviewerId         String?                @map("content_reviewer_id")
  contentReviewer           User?                  @relation("DocWorkflowContentReviewer", fields: [contentReviewerId], references: [id], onDelete: SetNull)
  contentApprovedAt         DateTime?              @map("content_approved_at")
  contentReviewNotes        String?                @map("content_review_notes") @db.Text

  // Format Check (Kiểm tra thể thức kỹ thuật NĐ 30/2020)
  formatReviewSubmittedAt   DateTime?              @map("format_review_submitted_at")
  formatReviewerId          String?                @map("format_reviewer_id")
  formatReviewer            User?                  @relation("DocWorkflowFormatReviewer", fields: [formatReviewerId], references: [id], onDelete: SetNull)
  formatApprovedAt          DateTime?              @map("format_approved_at")
  formatReviewNotes         String?                @map("format_review_notes") @db.Text

  // Authorized Sign (Ký chức danh / Thẩm quyền)
  authorizedSignerId        String?                @map("authorized_signer_id")
  authorizedSigner          User?                  @relation("DocWorkflowAuthorizedSigner", fields: [authorizedSignerId], references: [id], onDelete: SetNull)
  authorizedSignedAt        DateTime?              @map("authorized_signed_at")
  signingNotes              String?                @map("signing_notes") @db.Text

  // Numbering (Văn thư cấp số đi)
  numberedAt                DateTime?              @map("numbered_at")
  numbererId                String?                @map("numberer_id")
  numberer                  User?                  @relation("DocWorkflowNumberer", fields: [numbererId], references: [id], onDelete: SetNull)
  outgoingNumber            Int?                   @map("outgoing_number")
  outgoingNumberStr         String?                @map("outgoing_number_str") @db.VarChar(100)

  // Organization Digital Signature (Văn thư đóng dấu số cơ quan NĐ 30 & NĐ 68)
  orgSignedAt               DateTime?              @map("org_signed_at")
  orgSignerId               String?                @map("org_signer_id")
  orgSigner                 User?                  @relation("DocWorkflowOrgSigner", fields: [orgSignerId], references: [id], onDelete: SetNull)

  // Issue (Phát hành)
  issuedAt                  DateTime?              @map("issued_at")
  issuerId                  String?                @map("issuer_id")
  issuer                    User?                  @relation("DocWorkflowIssuer", fields: [issuerId], references: [id], onDelete: SetNull)
  recipientList             String?                @map("recipient_list") @db.Text
  deliveryMethod            String?                @map("delivery_method") @db.VarChar(100)

  // Delivery, Filing & Archival
  deliveredAt               DateTime?              @map("delivered_at")
  filedAt                   DateTime?              @map("filed_at")
  filedById                 String?                @map("filed_by_id")
  filedBy                   User?                  @relation("DocWorkflowOutgoingFiledBy", fields: [filedById], references: [id], onDelete: SetNull)
  dossierId                 String?                @map("dossier_id") @db.VarChar(100)

  archivedAt                DateTime?              @map("archived_at")
  archivedById              String?                @map("archived_by_id")
  archivedBy                User?                  @relation("DocWorkflowOutgoingArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  @@index([status])
  @@index([authorizedSignerId])
  @@index([contentReviewerId])
  @@index([formatReviewerId])
  @@map("document_outgoing_workflows")
}

model SignatureRecord {
  id                   String                      @id @default(cuid())
  documentId           String                      @map("document_id")
  document             Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version              Int                         @default(1)
  signerUserId         String                      @map("signer_user_id")
  signerUser           User                        @relation("UserSignatures", fields: [signerUserId], references: [id], onDelete: Restrict)
  signerAssignmentId   String?                     @map("signer_assignment_id")
  signerAssignment     PositionAssignment?         @relation(fields: [signerAssignmentId], references: [id], onDelete: SetNull)
  signingCapacity      String                      @map("signing_capacity") @db.VarChar(100)
  signatureType        SignatureType               @default(PERSONAL_DIGITAL) @map("signature_type")
  certificateMetadata  Json?                       @map("certificate_metadata")
  signedAt             DateTime                    @default(now()) @map("signed_at")
  verificationStatus   SignatureVerificationStatus @default(VALID) @map("verification_status")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  @@index([documentId, version])
  @@index([signerUserId])
  @@index([verificationStatus])
  @@map("signature_records")
}

// ===================================================
// 5. PUSH NOTIFICATIONS & PWA SUBSCRIPTIONS
// ===================================================
enum PushSubscriptionStatus {
  ACTIVE
  REVOKED
}

model PushSubscription {
  id               String                 @id @default(cuid())
  userId           String                 @map("user_id")
  endpoint         String                 @unique
  p256dh           String
  auth             String
  userAgent        String?                @map("user_agent")
  deviceType       String?                @map("device_type")
  status           PushSubscriptionStatus @default(ACTIVE)
  failureCount     Int                    @default(0) @map("failure_count")
  lastFailureCode  Int?                   @map("last_failure_code")
  lastSeenAt       DateTime?              @map("last_seen_at")
  disabledAt       DateTime?              @map("disabled_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("push_subscriptions")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  actorName   String?   @map("actor_name")
  title       String
  body        String
  category    String    @default("task")
  type        String
  linkHref    String    @map("link_href")
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ===================================================
// 6. ATOMIC TASK SEQUENCING (QCET-PERF-2025-01)
// ===================================================
model TaskSequence {
  year           Int
  scope          String
  departmentCode String   @map("department_code")
  lastValue      Int      @default(0) @map("last_value")
