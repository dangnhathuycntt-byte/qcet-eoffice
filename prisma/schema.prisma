// ===================================================
// 7. VỊ TRÍ VIỆC LÀM (NGHỊ ĐỊNH 106/2020/NĐ-CP) & MA TRẬN DACUM
// ===================================================
enum JobCatalogGroup {
  LDPU // Lãnh đạo, quản lý (Điều 4 NĐ 106)
  VCMN // Chức danh nghề nghiệp chuyên ngành (Giảng viên, Giáo viên GDNN)
  VCDC // Chức danh nghề nghiệp chuyên môn dùng chung (Kế toán, CNTT, Hành chính)
  HTPV // Vị trí việc làm hỗ trợ, phục vụ (Văn thư, Bảo vệ, Phục vụ xưởng)
}

model JobCatalogItem {
  id            String          @id @db.VarChar(50)
  code          String          @unique @db.VarChar(50)
  title         String          @db.VarChar(255)
  group         JobCatalogGroup
  description   String?         @db.Text
  competencyReq String?         @map("competency_req") @db.Text
  duties        DacumDuty[]
  positionDefinitions PositionDefinition[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("job_catalog_items")
}

model DacumDuty {
  id               String          @id @db.VarChar(50)
  code             String          @db.VarChar(20)
  title            String          @db.VarChar(255)
  jobCatalogItemId String?         @map("job_catalog_item_id") @db.VarChar(50)
  jobCatalogItem   JobCatalogItem? @relation(fields: [jobCatalogItemId], references: [id], onDelete: SetNull)
  taskDefs         DacumTaskDef[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("dacum_duties")
}

model DacumTaskDef {
  id                   String          @id @db.VarChar(50)
  code                 String          @db.VarChar(20)
  title                String          @db.VarChar(500)
  dutyId               String          @map("duty_id") @db.VarChar(50)
  duty                 DacumDuty       @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  criteria             String?         @db.Text
  tools                String?         @db.Text
  requiredDeliverables String?         @map("required_deliverables") @db.Text
  standardHours        Float           @default(0) @map("standard_hours")
  tasks                Task[]
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@unique([dutyId, code])
  @@map("dacum_task_defs")
}

// ===================================================
// 8. CƠ CẤU TỔ CHỨC, VỊ TRÍ VIỆC LÀM & ỦY QUYỀN (PHASE 3)
// Đáp ứng QĐ 282/QĐ-CĐKTCNQN, QĐ 420/QĐ-CĐKTCNQN & Nghị định 232/2026/NĐ-CP
// ===================================================

enum UnitType {
  SCHOOL
  FACULTY
  DEPARTMENT
  CENTER
  SECTION
  OTHER
}

enum UnitStatus {
  ACTIVE
  REORGANIZING
  MERGED
  DISSOLVED
  SUSPENDED
}

enum OrganizationalBodyType {
  COUNCIL
  COMMITTEE
  STEERING_COMMITTEE
  WORKING_GROUP
}

enum BodyStatus {
  ACTIVE
  CONCLUDED
  SUSPENDED
  DISSOLVED
}

enum BodyMemberRole {
  CHAIR
  VICE_CHAIR
  SECRETARY
  MEMBER
}

enum AssignmentType {
  PRIMARY
  CONCURRENT
  ACTING
}

enum AssignmentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  SUPERSEDED
}

enum ResponsibilityCategory {
  EXECUTIVE
  ACADEMIC
  OPERATIONAL
}

enum DelegationStatus {
  ACTIVE
  REVOKED
  EXPIRED
  PENDING
}

model OrganizationalUnit {
  id               String               @id @default(cuid())
  code             String               @unique @db.VarChar(50)
  name             String               @db.VarChar(255)
  type             UnitType
  parentId         String?              @map("parent_id")
  status           UnitStatus           @default(ACTIVE)
  effectiveFrom    DateTime             @default(now()) @map("effective_from")
  effectiveTo      DateTime?            @map("effective_to")
  metadata         Json?
  parent           OrganizationalUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         OrganizationalUnit[] @relation("UnitHierarchy")
  ancestorPaths    UnitClosurePath[]    @relation("UnitClosureAncestor")
  descendantPaths  UnitClosurePath[]    @relation("UnitClosureDescendant")
  positionAssignments PositionAssignment[]
  leadTasks           Task[]               @relation("TaskLeadUnit")
  taskActors          TaskActor[]
  leadWorkflows       DocumentIncomingWorkflow[] @relation("DocWorkflowLeadUnit")
  unitAssignments     UnitWorkAssignment[]       @relation("UnitWorkAssignmentUnit")
  workDossiers        WorkDossier[]
  meetings            Meeting[]
  meetingResolutions  MeetingResolution[]        @relation("UnitMeetingResolutions")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([type, status])
  @@map("organizational_units")
}

model UnitClosurePath {
  ancestorId   String             @map("ancestor_id")
  descendantId String             @map("descendant_id")
  depth        Int
  ancestor     OrganizationalUnit @relation("UnitClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant   OrganizationalUnit @relation("UnitClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("unit_closure_paths")
}

model OrganizationalBody {
  id            String                 @id @default(cuid())
  code          String                 @unique @db.VarChar(50)
  name          String                 @db.VarChar(255)
  type          OrganizationalBodyType
  establishedBy String?                @map("established_by") @db.VarChar(255)
  effectiveFrom DateTime               @default(now()) @map("effective_from")
  effectiveTo   DateTime?              @map("effective_to")
  status        BodyStatus             @default(ACTIVE)
  memberships   BodyMembership[]
  meetings      Meeting[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([type, status])
  @@map("organizational_bodies")
}

model BodyMembership {
  id                   String              @id @default(cuid())
  bodyId               String              @map("body_id")
  positionAssignmentId String?             @map("position_assignment_id")
  userId               String?             @map("user_id")
  role                 BodyMemberRole
  appointedAt          DateTime            @default(now()) @map("appointed_at")
  expiresAt            DateTime?           @map("expires_at")
  body                 OrganizationalBody  @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  positionAssignment   PositionAssignment? @relation(fields: [positionAssignmentId], references: [id], onDelete: SetNull)
  user                 User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([bodyId, role])
  @@index([userId])
  @@index([positionAssignmentId])
  @@map("body_memberships")
}

model PositionDefinition {
  id                String               @id @default(cuid())
  code              String               @unique @db.VarChar(50)
  title             String               @db.VarChar(255)
  group             JobCatalogGroup
  minLevel          Int?                 @default(1) @map("min_level")
  isLeadership      Boolean              @default(false) @map("is_leadership")
  dacumJobCatalogId String?              @map("dacum_job_catalog_id") @db.VarChar(50)
  dacumJobCatalog   JobCatalogItem?      @relation(fields: [dacumJobCatalogId], references: [id], onDelete: SetNull)
  assignments       PositionAssignment[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([group])
  @@map("position_definitions")
}

model PositionAssignment {
  id                   String                 @id @default(cuid())
  userId               String                 @map("user_id")
  positionDefinitionId String                 @map("position_definition_id")
  unitId               String                 @map("unit_id")
  type                 AssignmentType         @default(PRIMARY)
  effectiveFrom        DateTime               @default(now()) @map("effective_from")
  effectiveTo          DateTime?              @map("effective_to")
  status               AssignmentStatus       @default(ACTIVE)
  sourceDecisionNumber String?                @map("source_decision_number") @db.VarChar(100)
  user                 User                   @relation("UserPositionAssignments", fields: [userId], references: [id], onDelete: Cascade)
  positionDefinition   PositionDefinition     @relation(fields: [positionDefinitionId], references: [id], onDelete: Restrict)
  unit                 OrganizationalUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  portfolios           PortfolioAssignment[]
  bodyMemberships      BodyMembership[]
  delegationsGranted   DelegationGrant[]      @relation("GrantorDelegations")
  delegationsReceived  DelegationGrant[]      @relation("GranteeDelegations")
  primaryTasks         Task[]                 @relation("TaskPrimaryAssignment")
  taskApprovalSteps    TaskApprovalStep[]
  signatures           SignatureRecord[]
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([unitId, status])
  @@index([positionDefinitionId])
  @@map("position_assignments")
}

model ResponsibilityArea {
  id                   String                 @id @default(cuid())
  code                 String                 @unique @db.VarChar(50)
  name                 String                 @db.VarChar(255)
  description          String?                @db.Text
  category             ResponsibilityCategory
  portfolioAssignments PortfolioAssignment[]
  delegationGrants     DelegationGrant[]
  incomingWorkflows    DocumentIncomingWorkflow[] @relation("DocWorkflowRespArea")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@map("responsibility_areas")
}

model PortfolioAssignment {
  id                   String             @id @default(cuid())
  positionAssignmentId String             @map("position_assignment_id")
  responsibilityAreaId String             @map("responsibility_area_id")
  effectiveFrom        DateTime           @default(now()) @map("effective_from")
  effectiveTo          DateTime?          @map("effective_to")
  sourceDecisionNumber String?            @map("source_decision_number") @db.VarChar(100)
  positionAssignment   PositionAssignment @relation(fields: [positionAssignmentId], references: [id], onDelete: Cascade)
  responsibilityArea   ResponsibilityArea @relation(fields: [responsibilityAreaId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@unique([positionAssignmentId, responsibilityAreaId], name: "assignment_responsibility_unique")
  @@index([responsibilityAreaId])
  @@map("portfolio_assignments")
}

model DelegationGrant {
  id                   String               @id @default(cuid())
  grantorAssignmentId  String               @map("grantor_assignment_id")
  granteeAssignmentId  String               @map("grantee_assignment_id")
  responsibilityAreaId String?              @map("responsibility_area_id")
  action               String               @db.VarChar(100)
  resourceScope        String               @map("resource_scope") @db.VarChar(100)
  validFrom            DateTime             @map("valid_from")
  validUntil           DateTime             @map("valid_until")
  sourceDocumentNumber String               @map("source_document_number") @db.VarChar(100)
  reason               String?              @db.Text
  status               DelegationStatus     @default(ACTIVE)
  revokedAt            DateTime?            @map("revoked_at")
  revokedReason        String?              @map("revoked_reason") @db.Text
  grantorAssignment    PositionAssignment   @relation("GrantorDelegations", fields: [grantorAssignmentId], references: [id], onDelete: Restrict)
  granteeAssignment    PositionAssignment   @relation("GranteeDelegations", fields: [granteeAssignmentId], references: [id], onDelete: Restrict)
  responsibilityArea   ResponsibilityArea?  @relation(fields: [responsibilityAreaId], references: [id], onDelete: SetNull)
  scopeRules           DelegationScopeRule[]
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([grantorAssignmentId, status])
  @@index([granteeAssignmentId, status])
  @@index([validFrom, validUntil, status])
  @@map("delegation_grants")
}

model DelegationScopeRule {
  id                String          @id @default(cuid())
  delegationGrantId String          @map("delegation_grant_id")
  entityType        String          @map("entity_type") @db.VarChar(50)
  entityId          String?         @map("entity_id") @db.VarChar(100)
  constraintType    String          @map("constraint_type") @db.VarChar(50)
  delegationGrant   DelegationGrant @relation(fields: [delegationGrantId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([delegationGrantId])
  @@map("delegation_scope_rules")
}

// ===================================================
// 9. QUẢN LÝ NHIỆM VỤ REBAC, TIẾN ĐỘ & QUY TRÌNH DUYỆT (PHASE 5)
// Đáp ứng QĐ 283/QĐ-CĐKTCNQN, QĐ 203/QĐ-CĐKTCNQN & QĐ 420/QĐ-CĐKTCNQN
// ===================================================

enum TaskActorRole {
  ASSIGNER
  LEAD_UNIT
  COORDINATING_UNIT
  DRI
  COLLABORATOR
  FOLLOWER
  REVIEWER
  APPROVER
  OBSERVER
}

enum TaskOriginLevel {
  SCHOOL
  UNIT
  PERSONAL
}

enum ApprovalProcessStatus {
  NOT_STARTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  BYPASSED
}

enum TaskRelationType {
  BLOCKS
  DEPENDS_ON
  PARENT_CHILD
  DUPLICATE_OF
  DERIVED_FROM
}

model TaskActor {
  id           String              @id @default(cuid())
  taskId       String              @map("task_id")
  task         Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       String?             @map("user_id")
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  unitId       String?             @map("unit_id")
  unit         OrganizationalUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  role         TaskActorRole
  isPrimaryDRI Boolean             @default(false) @map("is_primary_dri")
  assignedById String?             @map("assigned_by_id")
  assignedBy   User?               @relation("ActorAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  appointedAt  DateTime            @default(now()) @map("appointed_at")
  notes        String?             @db.Text

  @@index([taskId, role])
  @@index([userId])
  @@index([unitId])
  @@map("task_actors")
}

model TaskApprovalProcess {
  id               String                @id @default(cuid())
  taskId           String                @map("task_id")
  task             Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status           ApprovalProcessStatus @default(NOT_STARTED)
  totalSteps       Int                   @default(1) @map("total_steps")
  currentStepIndex Int                   @default(0) @map("current_step_index")
  steps            TaskApprovalStep[]
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([taskId, status])
  @@map("task_approval_processes")
}

model TaskApprovalStep {
  id                   String              @id @default(cuid())
  processId            String              @map("process_id")
  process              TaskApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  stepOrder            Int                 @map("step_order")
  title                String              @db.VarChar(255)
  reviewerAssignmentId String?             @map("reviewer_assignment_id")
  reviewerAssignment   PositionAssignment? @relation(fields: [reviewerAssignmentId], references: [id], onDelete: SetNull)
  reviewerUserId       String?             @map("reviewer_user_id")
  reviewerUser         User?               @relation(fields: [reviewerUserId], references: [id], onDelete: SetNull)
  status               ApprovalStepStatus  @default(PENDING)
  decisionNote         String?             @map("decision_note") @db.Text
  decidedAt            DateTime?           @map("decided_at")

  @@index([processId, stepOrder])
  @@map("task_approval_steps")
}

model TaskResult {
  id                String    @id @default(cuid())
  taskId            String    @map("task_id")
  task              Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedByUserId String    @map("submitted_by_user_id")
  submittedByUser   User      @relation("TaskResultSubmitter", fields: [submittedByUserId], references: [id])
  summary           String    @db.Text
  reportUrl         String?   @map("report_url") @db.Text
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  verifiedByUserId  String?   @map("verified_by_user_id")
  verifiedByUser    User?     @relation("TaskResultVerifier", fields: [verifiedByUserId], references: [id])
  verifiedAt        DateTime? @map("verified_at")

  @@index([taskId])
  @@map("task_results")
}

model TaskRelation {
  id           String           @id @default(cuid())
  sourceTaskId String           @map("source_task_id")
  sourceTask   Task             @relation("SourceTaskRelations", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTaskId String           @map("target_task_id")
  targetTask   Task             @relation("TargetTaskRelations", fields: [targetTaskId], references: [id], onDelete: Cascade)
  relationType TaskRelationType @map("relation_type")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([sourceTaskId, targetTaskId, relationType])
  @@map("task_relations")
}

// ===================================================
// 10. BẢNG GHI IDEMPOTENCY CHO MOBILE/PWA RETRIES (TASK 8)
// ===================================================

model IdempotencyRecord {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  operation   String   @map("operation")
  key         String   @map("key")
  status      String   @default("PENDING") @map("status") // PENDING, COMPLETED, FAILED
  response    Json?    @map("response")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ===================================================
// 11. BẢNG GHI AUDIT LOG BẤT BIẾN (TASK 9)
// ===================================================

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String   @map("action")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  requestId  String?  @map("request_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  metadata   Json?    @map("metadata")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_events")
}

// ===================================================
// 12. TRANSACTIONAL OUTBOX PATTERN (TASK 10)
// ===================================================

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json         @map("payload")
  status        OutboxStatus @default(PENDING) @map("status")
  attempts      Int          @default(0) @map("attempts")
  lastError     String?      @map("last_error")
  availableAt   DateTime     @default(now()) @map("available_at")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// ===================================================
// 13. WORK DOSSIER & ARCHIVAL DOMAIN (PHASE 7 / NĐ 30/2020)
// ===================================================

enum DossierStatus {
  OPEN
  ACTIVE
  CLOSED
  READY_FOR_ARCHIVE
  SUBMITTED_TO_ARCHIVE
  ACCEPTED
  ARCHIVED
}

enum DossierItemType {
  DOCUMENT
  TASK
  RESULT
  DECISION
  MEETING_MINUTES
  ATTACHMENT
}

enum DataClassification {
  PUBLIC
  INTERNAL
  RESTRICTED
  PERSONAL_DATA
}

model RetentionRule {
  id            String        @id @default(cuid())
  code          String        @unique @db.VarChar(50)
  name          String        @db.VarChar(255)
  durationYears Int?          @map("duration_years") // null = vĩnh viễn
  legalBasis    String?       @map("legal_basis") @db.VarChar(255)
  description   String?       @db.Text
  dossiers      WorkDossier[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("retention_rules")
}

model WorkDossier {
  id                  String             @id @default(cuid())
  code                String             @unique @db.VarChar(100)
  title               String             @db.VarChar(500)
  owningUnitId        String             @map("owning_unit_id")
  owningUnit          OrganizationalUnit @relation(fields: [owningUnitId], references: [id], onDelete: Restrict)
  responsiblePersonId String             @map("responsible_person_id")
  responsiblePerson   User               @relation("DossierResponsiblePerson", fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  openedAt            DateTime           @default(now()) @map("opened_at")
  closedAt            DateTime?          @map("closed_at")
  retentionRuleId     String?            @map("retention_rule_id")
  retentionRule       RetentionRule?     @relation(fields: [retentionRuleId], references: [id], onDelete: SetNull)
  status              DossierStatus      @default(OPEN)
  classification      DataClassification @default(INTERNAL)
  storageLocation     String?            @map("storage_location") @db.VarChar(255)
  submittedArchiveAt  DateTime?          @map("submitted_archive_at")
  submittedById       String?            @map("submitted_by_id")
  submittedBy         User?              @relation("DossierSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  archivedAt          DateTime?          @map("archived_at")
  archivedById        String?            @map("archived_by_id")
  archivedBy          User?              @relation("DossierArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  notes               String?            @db.Text
  items               DossierItem[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@index([owningUnitId])
  @@index([responsiblePersonId])
  @@index([submittedById])
  @@index([status])
  @@index([classification])
  @@map("work_dossiers")
}

model DossierItem {
  id             String          @id @default(cuid())
  dossierId      String          @map("dossier_id")
  dossier        WorkDossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  itemType       DossierItemType @map("item_type")
  itemId         String?         @map("item_id") @db.VarChar(100)
  title          String          @db.VarChar(500)
  documentNumber String?         @map("document_number") @db.VarChar(100)
  documentDate   DateTime?       @map("document_date")
  pageCount      Int?            @map("page_count")
  sequence       Int             @default(1)
  addedById      String          @map("added_by_id")
  addedBy        User            @relation("DossierItemAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  addedAt        DateTime        @default(now()) @map("added_at")
  notes          String?         @db.Text

  @@index([dossierId])
  @@index([itemType, itemId])
  @@map("dossier_items")
}

// ===================================================
// 14. INSTITUTIONAL MEETINGS, BODIES & RESOLUTIONS (PHASE 8)
// ===================================================

enum MeetingStatus {
  DRAFT_AGENDA
  INVITED
  HELD
  MINUTES_DRAFT
  MINUTES_CONFIRMED
  CANCELLED
}

enum MeetingParticipantRole {
  CHAIR
  SECRETARY
  ATTENDEE
  INVITED_GUEST
}

enum AttendanceStatus {
  INVITED
  ACCEPTED
  DECLINED
  ATTENDED
  ABSENT
}

model Meeting {
  id                   String                 @id @default(cuid())
  title                String                 @db.VarChar(500)
  code                 String?                @unique @db.VarChar(100)
  bodyId               String?                @map("body_id")
  unitId               String?                @map("unit_id")
  organizerId          String                 @map("organizer_id")
  status               MeetingStatus          @default(DRAFT_AGENDA)
  startTime            DateTime               @map("start_time")
  endTime              DateTime?              @map("end_time")
  location             String?                @db.VarChar(255)
  agenda               String?                @db.Text
  materialsUrl         String?                @map("materials_url") @db.Text
  minutes              String?                @db.Text
  minutesConfirmedAt   DateTime?              @map("minutes_confirmed_at")
  minutesConfirmedById String?                @map("minutes_confirmed_by_id")
  body                 OrganizationalBody?    @relation(fields: [bodyId], references: [id], onDelete: SetNull)
  unit                 OrganizationalUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  organizer            User                   @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  participants         MeetingParticipant[]
  resolutions          MeetingResolution[]
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@index([status, startTime])
  @@index([bodyId])
  @@index([unitId])
  @@index([organizerId])
  @@map("meetings")
}

model MeetingParticipant {
  id               String                 @id @default(cuid())
  meetingId        String                 @map("meeting_id")
  userId           String                 @map("user_id")
  role             MeetingParticipantRole @default(ATTENDEE)
  attendanceStatus AttendanceStatus       @default(INVITED) @map("attendance_status")
  notes            String?                @db.Text
  meeting          Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

model MeetingResolution {
  id              String              @id @default(cuid())
  meetingId       String              @map("meeting_id")
  code            String?             @db.VarChar(100)
  title           String              @db.VarChar(500)
  content         String              @db.Text
  leadUnitId      String?             @map("lead_unit_id")
  leadUserId      String?             @map("lead_user_id")
  deadline        DateTime?
  resultingTaskId String?             @map("resulting_task_id")
  meeting         Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  leadUnit        OrganizationalUnit? @relation("UnitMeetingResolutions", fields: [leadUnitId], references: [id], onDelete: SetNull)
  leadUser        User?               @relation("MeetingResolutionLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  resultingTask   Task?               @relation(fields: [resultingTaskId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([meetingId])
  @@index([leadUnitId])
  @@index([leadUserId])
  @@map("meeting_resolutions")
}


