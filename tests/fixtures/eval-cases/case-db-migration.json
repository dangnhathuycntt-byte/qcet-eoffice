{
  "runId": "eval-case-db-migration",
  "planPath": "docs/plans/eval-case-db-migration.md",
  "requirements": [
    { "id": "REQ-DB-01", "description": "Prisma schema models for academic operations without enum expansion" },
    { "id": "REQ-DB-02", "description": "Database access repository with strict transaction boundaries" },
    { "id": "REQ-DB-03", "description": "Academic operations domain service adhering to server truth" }
  ],
  "shards": [
    {
      "id": "shard-db-schema",
      "objective": "Define Prisma schema models",
      "kind": "migration",
      "owns": ["prisma/schema.prisma"],
      "antiOwns": ["src/server/services/**"],
      "requirements": ["REQ-DB-01"],
      "dependencies": [],
      "isolation": "worktree",
      "testHints": ["tests/db-schema.test.ts"]
    },
    {
      "id": "shard-db-access",
      "objective": "Database access repository",
      "kind": "infrastructure",
      "owns": ["src/server/db/data-access.ts"],
      "antiOwns": ["prisma/**", "src/server/services/**"],
      "requirements": ["REQ-DB-02"],
      "dependencies": ["shard-db-schema"],
      "isolation": "none",
      "testHints": ["tests/data-access.test.ts"]
    },
    {
      "id": "shard-db-service",
      "objective": "Academic operations domain service",
      "kind": "feature",
      "owns": ["src/server/services/academic-ops.ts"],
      "antiOwns": ["prisma/**", "src/server/db/**"],
      "requirements": ["REQ-DB-03"],
      "dependencies": ["shard-db-access"],
      "isolation": "none",
      "testHints": ["tests/academic-ops.test.ts"]
    }
  ]
}
