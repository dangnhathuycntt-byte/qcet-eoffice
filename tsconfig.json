{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@qcet/contracts/*": ["./packages/contracts/src/*"],
      "@qcet/shared/*": ["./packages/shared/src/*"],
      "@qcet/db/*": ["./packages/db/src/*"],
      "@/*": ["./apps/api/src/*", "./apps/web/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "apps", "tests/executor", "artifacts"]
}
