{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@qcet/contracts/*": [
        "./packages/contracts/src/*"
      ],
      "@qcet/shared/*": [
        "./packages/shared/src/*"
      ],
      "@qcet/db/*": [
        "./packages/db/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/executor",
    "tests/incoming-documents-v2.test.ts",
    "tests/outgoing-documents-v2.test.ts",
    "artifacts"
  ]
}
